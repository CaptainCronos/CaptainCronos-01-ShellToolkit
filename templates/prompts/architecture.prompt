# ==============================================================================
# Captain Cronos Shell Toolkit Prompt Template
# ------------------------------------------------------------------------------
# Template    : architecture
# Title       : Architecture Review
# Description : Render an architecture design prompt.
# Order       : 60
# Version     : 1.0.0-alpha1
# Category    : Prompt
# Author      : Captain Cronos Project
# Tags        : architecture, design, review
# Validation  : question-rules
# Default     : question defaults
# Examples    : architecture_topic, design_goal, integration_points
# Output      : markdown
# Clipboard   : planned
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Render an architecture design prompt.
# ==============================================================================

[questions]
architecture_topic|text|yes|Architecture topic||Capability, subsystem, or integration being designed.||Prompt Engine session lifecycle
current_constraints|textarea|yes|Current constraints||Existing standards, paths, or compatibility rules.||No new namespace should be added.
design_goal|textarea|yes|Design goal||What the architecture needs to enable.||Reusable interactive prompt flow for future commands.
integration_points|textarea|yes|Integration points||Libraries, commands, metadata, docs, or templates involved.||lib/cc-prompt-engine.sh and tools/commands/prompt
validation|textarea|yes|Validation||Review and verification expectations.||cc selftest

[template]
# Architecture Prompt

Topic:
{{architecture_topic}}

Current constraints:
{{current_constraints}}

Design goal:
{{design_goal}}

Integration points:
{{integration_points}}

Architecture guidance:
- Fit new behavior into existing top-level directories unless the roadmap approves a layout change.
- Keep shared mechanisms reusable and metadata-driven.
- Separate internal infrastructure from public command surfaces.
- Describe migration and validation expectations before implementation.

Validation:
{{validation}}
