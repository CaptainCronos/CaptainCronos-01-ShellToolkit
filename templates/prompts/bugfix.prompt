# ==============================================================================
# Captain Cronos Shell Toolkit Prompt Template
# ------------------------------------------------------------------------------
# Template    : bugfix
# Title       : Bugfix
# Description : Render a bugfix investigation prompt.
# Order       : 20
# Version     : 1.0.0-alpha1
# Category    : Prompt
# Author      : Captain Cronos Project
# Tags        : bugfix, defect, regression
# Validation  : question-rules
# Default     : question defaults
# Examples    : bug_summary, observed_behavior, expected_behavior
# Output      : markdown
# Clipboard   : planned
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Render a bugfix investigation prompt.
# ==============================================================================

[questions]
bug_summary|text|yes|Bug summary||Short description of the defect.||Prompt validation rejects valid answers.
observed_behavior|textarea|yes|Observed behavior||What currently happens.||A required answer is not preserved after Back.
expected_behavior|textarea|yes|Expected behavior||What should happen instead.||Navigation preserves existing answers.
suspected_area|textarea|no|Suspected area||Relevant files, commands, or recent changes.||tools/commands/prompt
validation|textarea|yes|Validation||Regression checks that must pass.||cc verify

[template]
# Bugfix Prompt

Bug:
{{bug_summary}}

Observed behavior:
{{observed_behavior}}

Expected behavior:
{{expected_behavior}}

Suspected area:
{{suspected_area}}

Investigation guidance:
- Reproduce or reason from the smallest failing path first.
- Identify the root cause before editing.
- Keep the fix focused and avoid unrelated cleanup.
- Add or update validation that would catch the regression.

Validation:
{{validation}}
