#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : cc
# Version     : reads VERSION
# Category    : Core
# Requires    : bash git grep sed awk
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Unified command dispatcher for Captain Cronos Shell Toolkit.
# ==============================================================================

set -euo pipefail

DEFAULT_TOOLKIT_ROOT="$HOME/GitHub/CaptainCronos-01-ShellToolkit"
ORIGINAL_PWD="${PWD:-$(pwd)}"

# Discovery must not initialize or consult mutable runtime state. Detect it
# before loading dependency/package libraries, then remove caller-owned config
# that could cause those libraries to create host resources.
CC_DISCOVERY_REQUEST=0
for cc_arg in "$@"; do
    [ "$cc_arg" = switches ] || continue
    CC_DISCOVERY_REQUEST=1
    break
done
if [ "$CC_DISCOVERY_REQUEST" -eq 1 ]; then
    unset BASH_ENV ENV CC_PROGRAMS_CONFIG CC_PROGRAMS_LOADED
    unset CC_HOME CC_CONFIG CC_HOST_HOME CC_REPORT_DIR CC_ASSET_DIR
fi

cc_launcher_canonical_dir() {
    local path="$1"
    [ -d "$path" ] || return 1
    (cd "$path" && pwd -P)
}

cc_launcher_is_toolkit_root() {
    local root="$1"
    [ -n "$root" ] &&
        [ -f "$root/lib/cc-context.sh" ] &&
        [ -f "$root/lib/cc-common.sh" ] &&
        [ -d "$root/tools/commands" ] &&
        [ -f "$root/tools/cc" ]
}

cc_launcher_resolve_toolkit_root() {
    local raw candidate script_dir

    for raw in "${CAPTAIN_CRONOS_TOOLKIT_ROOT:-}" "${CAPTAIN_CRONOS_REPO:-}"; do
        [ -n "$raw" ] || continue
        candidate="$(cc_launcher_canonical_dir "$raw" 2>/dev/null || true)"
        if cc_launcher_is_toolkit_root "$candidate"; then
            echo "$candidate"
            return 0
        fi

        echo "[CC ERROR] Invalid toolkit root: $raw" >&2
        echo "Expected a Shell Toolkit checkout containing lib/cc-common.sh and tools/commands." >&2
        return 1
    done

    script_dir="$(cc_launcher_canonical_dir "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null || true)"
    for raw in "$script_dir/.." "$script_dir" "$DEFAULT_TOOLKIT_ROOT"; do
        [ -n "$raw" ] || continue
        candidate="$(cc_launcher_canonical_dir "$raw" 2>/dev/null || true)"
        if cc_launcher_is_toolkit_root "$candidate"; then
            echo "$candidate"
            return 0
        fi
    done

    echo "[CC ERROR] Shell Toolkit repository not found." >&2
    echo "Set CAPTAIN_CRONOS_TOOLKIT_ROOT or clone to: $DEFAULT_TOOLKIT_ROOT" >&2
    return 1
}

TOOLKIT_ROOT="$(cc_launcher_resolve_toolkit_root)" || exit 1

cd "$TOOLKIT_ROOT"
source "$TOOLKIT_ROOT/lib/cc-context.sh"
source "$TOOLKIT_ROOT/lib/cc-common.sh"
source "$TOOLKIT_ROOT/lib/cc-deps.sh"
source "$TOOLKIT_ROOT/lib/cc-metadata.sh"
source "$TOOLKIT_ROOT/lib/cc-help.sh"
source "$TOOLKIT_ROOT/lib/cc-packages.sh"
cc_context_init "$TOOLKIT_ROOT" "$ORIGINAL_PWD"

COMMAND_DIR="$TOOLKIT_ROOT/tools/commands"

show_help() {
    local command_name command_desc script version category requires repository
    local max_name_length=0 leader_width minimum_dots=8 index
    local -a command_names=() command_descriptions=()

    while IFS=$'\t' read -r command_name script version category requires repository command_desc; do
        [ -n "$command_name" ] || continue
        command_names+=("$command_name")
        command_descriptions+=("${command_desc:-No description.}")
        if [ "${#command_name}" -gt "$max_name_length" ]; then
            max_name_length=${#command_name}
        fi
    done < <(cc_registry_tsv)
    leader_width=$((max_name_length + minimum_dots))

    echo "Captain Cronos Shell Toolkit"
    echo "============================"
    echo
    echo "Usage:"
    echo "  cc <command> [options]"
    echo
    echo "Commands:"
    for index in "${!command_names[@]}"; do
        printf '  '
        cc_dotted_line "${command_names[$index]}" "${command_descriptions[$index]}" "$leader_width"
    done
    echo
    echo "Examples:"
    echo "  cc version"
    echo "  cc repo"
    echo "  cc doctor"
    echo "  cc install --dry-run"
    echo "  cc install switches"
    echo "  cc kernel cleanup switches"
    echo "  cc update"
    echo
    echo "Toolkit root: $TOOLKIT_ROOT"
    echo "Current repo:  $CURRENT_REPO"
}

script_field() {
    local file="$1" field="$2"
    awk -v field="$field" '
        $0 ~ "^# " field "[[:space:]]*:" {
            sub("^# " field "[[:space:]]*:[[:space:]]*", "")
            print
            exit
        }
    ' "$file"
}

check_command_deps() {
    local file="$1" command_name="$2" deps dep missing=0 package status program
    local -a packages=()
    deps="$(script_field "$file" "Requires")"
    [ -n "$deps" ] || return 0

    for dep in $deps; do
        case "$dep" in
            bash|sh)
                continue
                ;;
        esac
        status="$(cc_dep_execution_status "$dep")"
        [ "$status" = "OK" ] && continue
        program="$(cc_dep_resolve_program "$dep")"
        if [ "$missing" -eq 0 ]; then
            cc_error "Missing required dependency for cc $command_name"
            echo
            echo "Dependency Check"
            echo "----------------"
        fi
        printf '%-18s %s' "$dep" "$status"
        package=""
        if [ "$status" = "MISSING" ]; then
            package="$(cc_dep_install_hint "$dep" 2>/dev/null || true)"
        fi
        if [ -n "$package" ]; then
            if [ "$package" != "$program" ]; then
                printf '  install package: %s' "$package"
            fi
            packages+=("$package")
        fi
        printf '\n'
        missing=$((missing + 1))
    done

    if [ "$missing" -gt 0 ]; then
        echo
        echo "Resolve missing dependencies and retry."
        if _cc_pkg_manager_exists && [ "${#packages[@]}" -gt 0 ]; then
            echo
            echo "Package installation preview:"
            CC_PKG_DRY_RUN=1 _cc_pkg_install "${packages[@]}"
        fi
        exit 127
    fi
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    help|--help|-h)
        show_help
        exit 0
        ;;
    --version)
        cmd="version"
        ;;
esac

command_path="$COMMAND_DIR/$cmd"

if [ ! -f "$command_path" ]; then
    cc_error "Unknown command: $cmd"
    echo
    show_help
    exit 1
fi

# Metadata/help rendering is repository-owned output.  Isolate it from
# caller-specific program mappings and shell startup hooks, including when
# switch discovery is invoked directly by a nested validation fixture.
if [ "${1:-}" = switches ] || [[ "${2:-}" =~ ^(--help|-h|switches)$ ]]; then
    unset BASH_ENV ENV CC_PROGRAMS_CONFIG CAPTAIN_CRONOS_REPO
fi

if [ "${1:-}" = switches ] && [ "$#" -eq 1 ]; then
    cc_help_render_switches "$cmd"
    exit 0
fi
if [[ "${2:-}" =~ ^(--help|-h)$ ]] && [ "$#" -eq 2 ]; then
    subcommand_row="$(cc_contract_subcommand_row "$cmd" "$1")"
    if [ -n "$subcommand_row" ]; then
        IFS='|' read -r _ _ _ subcommand_context <<< "$subcommand_row"
        cc_help_render_switches "$subcommand_context"
        exit 0
    fi
fi
if [ "${2:-}" = switches ] && [ "$#" -eq 2 ]; then
    subcommand_row="$(cc_contract_subcommand_row "$cmd" "$1")"
    if [ -z "$subcommand_row" ]; then
        cc_help_context_error "$cmd" "Unknown subcommand: $1" || status=$?
        exit "${status:-2}"
    fi
    IFS='|' read -r _ _ _ subcommand_context <<< "$subcommand_row"
    cc_help_render_switches "$subcommand_context"
    exit 0
fi

if cc_help_dispatch_preflight "$cmd" "$@"; then
    :
else
    status=$?
    exit "$status"
fi

case "${1:-}" in
    --help|-h|--version)
        # Documentation and operator help must not depend on runtime-only
        # command capabilities. The command still owns and renders its usage.
        ;;
    *)
        check_command_deps "$command_path" "$cmd"
        ;;
esac

bash "$command_path" "$@"
