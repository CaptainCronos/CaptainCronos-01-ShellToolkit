#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : env
# Version     : reads VERSION
# Category    : Core
# Requires    : bash mkdir stat mv chmod
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Inspect and repair Captain Cronos environment and PATH health.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-environment.sh"
source "$PROJECT_ROOT/lib/cc-path.sh"
source "$PROJECT_ROOT/lib/cc-platform.sh"

ACTION="summary"
APPLY=0

usage() {
    cat <<'EOF_HELP'
Usage:
  cc env [summary]
  cc env path [--fix|--apply]
  cc env shell
  cc env host
  cc env doctor [--fix|--apply]

Environment namespace for host identity, shell files, and PATH health.

PATH policy:
  PASS  required path is present exactly once
  WARN  required path is duplicated or directory is missing
  FAIL  required path is absent from PATH

Fix/apply behavior:
  - creates required directories when missing
  - atomically installs one canonical managed PATH block in ~/.bashrc
  - removes exact known legacy Captain Cronos PATH lines and guards
  - preserves unknown PATH customization and unrelated file content
  - preserves first occurrence order when showing the cleaned PATH
  - cannot modify the already-running parent shell's PATH
EOF_HELP
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --version)
            cc_version
            exit 0
            ;;
        summary|path|shell|host|doctor)
            ACTION="$1"
            shift
            ;;
        --fix|--apply)
            APPLY=1
            shift
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

path_status_for() {
    local label="$1" dir="$2" count status note
    count="$(cc_path_count_entry "$PATH" "$dir")"
    status="PASS"
    note=""

    if [ "$count" -eq 0 ]; then
        status="FAIL"
        note="missing from PATH"
    elif [ "$count" -gt 1 ]; then
        status="WARN"
        note="$count entries"
    elif [ ! -d "$dir" ]; then
        status="WARN"
        note="directory missing"
    fi

    if [ -n "$note" ]; then
        printf '%-18s ' "$label"
        cc_status_word "$status"
        printf ' %s\n' "$note"
    else
        printf '%-18s ' "$label"
        cc_status_word "$status"
        printf '\n'
    fi
}

path_overall() {
    local fail=0 warn=0 dir count
    for dir in "$HOME/bin" "$HOME/.local/bin"; do
        count="$(cc_path_count_entry "$PATH" "$dir")"
        if [ "$count" -eq 0 ]; then
            fail=$((fail + 1))
        elif [ "$count" -gt 1 ] || [ ! -d "$dir" ]; then
            warn=$((warn + 1))
        fi
    done
    if [ "$fail" -gt 0 ]; then echo FAIL
    elif [ "$warn" -gt 0 ]; then echo WARN
    else echo PASS
    fi
}

fix_path() {
    mkdir -p "$HOME/bin" "$HOME/.local/bin"
    cc_path_repair_bashrc "$HOME/.bashrc"
}

show_startup_path_status() {
    local status=PASS note="" known
    if ! cc_path_startup_audit "$HOME/.bashrc"; then
        status=WARN
        note="unsafe or unreadable ~/.bashrc"
    else
        known=$((CC_PATH_LEGACY_LINES + CC_PATH_LEGACY_GUARDS))
        if [ "$CC_PATH_CANONICAL_BLOCKS" -ne 1 ] || [ "$CC_PATH_CANONICAL_ENDS" -ne 1 ] ||
            [ "$CC_PATH_CANONICAL_MALFORMED" -ne 0 ]; then
            status=WARN
            note="canonical block missing or malformed"
        fi
        if [ "$known" -gt 0 ]; then
            status=WARN
            if [ -n "$note" ]; then note="$note; "; fi
            note="${note}$known known legacy writer(s)"
        fi
        if [ "$CC_PATH_AMBIGUOUS_LINES" -gt 0 ]; then
            status=WARN
            if [ -n "$note" ]; then note="$note; "; fi
            note="${note}${CC_PATH_AMBIGUOUS_LINES} ambiguous line(s) preserved"
        fi
    fi
    printf '%-18s ' "Startup config"
    cc_status_word "$status"
    [ -z "$note" ] || printf ' %s' "$note"
    printf '\n'
}

show_path() {
    local overall
    overall="$(path_overall)"
    echo "PATH Check"
    echo "----------"
    # These are display labels; the expanded paths are passed separately.
    # shellcheck disable=SC2088
    path_status_for "~/bin" "$HOME/bin"
    # shellcheck disable=SC2088
    path_status_for "~/.local/bin" "$HOME/.local/bin"
    show_startup_path_status
    printf '%-18s ' "Overall"
    cc_status_word "$overall"
    printf '\n'
    echo
    echo "Current PATH"
    echo "------------"
    echo "$PATH"
    echo
    echo "Deduplicated PATH"
    echo "-----------------"
    cc_path_deduplicated "$PATH"

    if [ "$APPLY" -eq 1 ]; then
        echo
        cc_log "Repairing Captain Cronos PATH startup configuration."
        fix_path || return
        cc_path_startup_audit "$HOME/.bashrc" || return
        cc_log "Startup configuration repaired with one canonical managed PATH block."
        if [ "$CC_PATH_AMBIGUOUS_LINES" -gt 0 ]; then
            cc_warn "$CC_PATH_AMBIGUOUS_LINES ambiguous PATH line(s) were preserved for manual review."
        fi
        if [ "$overall" = PASS ]; then
            cc_log "The current parent shell PATH was already healthy and was not changed."
        else
            cc_warn "Startup configuration is repaired; the current parent shell PATH remains $overall."
        fi
        cc_log "Run: source ~/.bashrc"
        cc_log "Or start a new interactive shell to load the repaired configuration."
        return 0
    elif [ "$overall" != "PASS" ]; then
        echo
        cc_warn "PATH health is $overall. Run: cc env path --fix"
    fi

    [ "$overall" != "FAIL" ]
}

show_shell() {
    echo "Shell Files"
    echo "-----------"
    for file in "$HOME/.bashrc" "$HOME/.bash_aliases" "$HOME/.bash_functions"; do
        if [ -f "$file" ]; then
            printf '%-24s ' "$(basename "$file")"
            cc_status_word PASS
            printf '\n'
        else
            printf '%-24s ' "$(basename "$file")"
            cc_status_word WARN
            printf ' missing\n'
        fi
    done
}

show_host() {
    echo "Host Environment"
    echo "----------------"
    cc_env_summary
    echo
    echo "Platform"
    echo "--------"
    cc_platform_summary
}

show_summary() {
    cc_banner
    echo
    show_host
    echo
    show_path
    echo
    show_shell
}

case "$ACTION" in
    summary)
        show_summary
        ;;
    path)
        cc_banner
        echo
        show_path
        ;;
    shell)
        cc_banner
        echo
        show_shell
        ;;
    host)
        cc_banner
        echo
        show_host
        ;;
    doctor)
        cc_banner
        echo
        show_host
        echo
        show_path
        echo
        show_shell
        ;;
esac
