#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : doctor
# Version     : 2.1.0-alpha1
# Category    : Diagnostics
# Requires    : bash git awk df smartctl uname find sort
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Run repository, installation, and host health checks.
# ==============================================================================

set -euo pipefail

ORIGINAL_PWD="${PWD:-$(pwd)}"
TOOLKIT_ROOT="${TOOLKIT_ROOT:-${PROJECT_ROOT:-}}"
if [ -z "$TOOLKIT_ROOT" ]; then
    TOOLKIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fi

cd "$TOOLKIT_ROOT"
source "$TOOLKIT_ROOT/lib/cc-context.sh"
source "$TOOLKIT_ROOT/lib/cc-common.sh"
source "$TOOLKIT_ROOT/lib/cc-kernel.sh"
cc_context_init "$TOOLKIT_ROOT" "${CURRENT_REPO:-$ORIGINAL_PWD}"

FULL=0
WARNINGS=0
FAILURES=0

usage() {
    echo "Usage: cc doctor [--full]"
    echo
    echo "Runs repository, installation, semantic kernel, and basic host health checks."
    echo "Use --full to include storage inventory and SMART summary."
}

run_cc() {
    local cmd="$1"
    shift
    if [ -r "$TOOLKIT_ROOT/tools/cc" ]; then
        bash "$TOOLKIT_ROOT/tools/cc" "$cmd" "$@" || true
    else
        WARNINGS=$((WARNINGS + 1))
        cc_status_line "cc $cmd available" "WARN"
        cc_warn "tools/cc not readable; skipping cc $cmd"
    fi
}

doctor_kernel_check() {
    local status severity code message
    cc_log "Checking kernel health..."
    if ! _cc_kernel_snapshot_capture "${KEEP_COUNT:-2}"; then
        WARNINGS=$((WARNINGS + 1))
        cc_status_line "Kernel health" "WARN"
        cc_warn "Kernel inspection could not produce a semantic snapshot."
        return 0
    fi

    status="$(_cc_kernel_snapshot_get health_status)"
    case "$status" in
        FAIL) FAILURES=$((FAILURES + 1)) ;;
        WARN) WARNINGS=$((WARNINGS + 1)) ;;
        PASS) ;;
        *)
            status=WARN
            WARNINGS=$((WARNINGS + 1))
            ;;
    esac
    cc_status_line "Kernel health" "$status"
    printf '%-18s %s\n' "Running kernel:" "$(_cc_kernel_snapshot_get running)"
    printf '%-18s %s / %s / %s / EFI runtime %s\n' \
        "Kernel platform:" \
        "$(_cc_kernel_snapshot_get distribution_family)" \
        "$(_cc_kernel_snapshot_get initramfs_provider)" \
        "$(_cc_kernel_snapshot_get bootloader)" \
        "$(_cc_kernel_snapshot_get efi_runtime_state)"
    while IFS=$'\t' read -r severity code message; do
        case "$severity" in
            FAIL) cc_error "Kernel [$code]: $message" ;;
            WARN) cc_warn "Kernel [$code]: $message" ;;
        esac
    done < <(_cc_kernel_snapshot_findings)
    return 0
}

doctor_main() {
    FULL=0
    WARNINGS=0
    FAILURES=0
    case "${1:-}" in
        --help|-h)
            usage
            return 0
            ;;
        --version)
            cc_version
            return 0
            ;;
        --full)
            FULL=1
            ;;
        "") ;;
        *) usage; return 2 ;;
    esac

cc_banner

echo "Captain Cronos Doctor"
echo "======================"
echo

cc_log "Running repository verification..."
if install/verify.sh; then
    cc_status_line "Repository verification" "PASS"
else
    FAILURES=$((FAILURES + 1))
    cc_status_line "Repository verification" "FAIL"
fi

cc_log "Checking Git status..."
if cc_repo_clean "$TOOLKIT_ROOT"; then
    cc_status_line "Working tree clean" "PASS"
else
    WARNINGS=$((WARNINGS + 1))
    cc_status_line "Working tree clean" "WARN"
    cc_warn "Working tree has uncommitted changes:"
    cc_repo_status_short "$TOOLKIT_ROOT" || true
fi

cc_log "Checking script syntax..."
syntax_ok=1
for script in install/*.sh tools/cc tools/commands/*; do
    [ -f "$script" ] || continue
    bash -n "$script" || syntax_ok=0
done
if [ "$syntax_ok" -eq 1 ]; then
    cc_status_line "Script syntax" "PASS"
else
    FAILURES=$((FAILURES + 1))
    cc_status_line "Script syntax" "FAIL"
fi

cc_log "Checking installed command front-end..."
if [ -x "$HOME/bin/cc" ]; then
    cc_status_line "Installed command" "PASS"
    cc_log "Installed command found: $HOME/bin/cc"
else
    WARNINGS=$((WARNINGS + 1))
    cc_status_line "Installed command" "WARN"
    cc_warn "Installed command missing or not executable: $HOME/bin/cc"
    cc_warn "Run: install/install.sh --apply"
fi

echo
cc_log "Checking host basics..."
printf '%-18s %s\n' "Hostname:" "$(hostname 2>/dev/null || echo unknown)"
printf '%-18s %s\n' "Kernel:" "$(uname -r 2>/dev/null || echo unknown)"
printf '%-18s %s\n' "Uptime:" "$(uptime -p 2>/dev/null || echo unknown)"
printf '%-18s %s\n' "Load:" "$(awk '{print $1" "$2" "$3}' /proc/loadavg 2>/dev/null || echo unknown)"

if [ "${CC_DOCTOR_SKIP_KERNEL:-0}" != 1 ]; then
    doctor_kernel_check
fi

cc_log "Checking disk pressure..."
if df -hT | awk 'NR==1 || /^\/dev\//' | awk 'NR==1 {print; next} {gsub(/%/,"",$6); print; if ($6+0 >= 90) high=1} END {if (high) exit 2}'; then
    cc_status_line "Disk pressure" "PASS"
else
    WARNINGS=$((WARNINGS + 1))
    cc_status_line "Disk pressure" "WARN"
    cc_warn "One or more filesystems are at or above 90%."
fi

cc_log "Checking SMART tooling..."
if command -v smartctl >/dev/null 2>&1; then
    cc_status_line "SMART tooling" "PASS"
    cc_log "smartctl found."
else
    WARNINGS=$((WARNINGS + 1))
    cc_status_line "SMART tooling" "WARN"
    cc_warn "smartctl not found. Install smartmontools for SMART checks."
fi

if [ "$FULL" -eq 1 ]; then
    echo
    echo "Storage Inventory"
    echo "-----------------"
    run_cc drives
    echo
    echo "SMART Summary"
    echo "-------------"
    run_cc smart
fi

echo
printf '%-16s ' "Overall Status:"
if [ "$FAILURES" -gt 0 ]; then
    cc_fail
elif [ "$WARNINGS" -gt 0 ]; then
    cc_warning
else
    cc_pass
fi
printf '\n'

[ "$FAILURES" -eq 0 ]
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    doctor_main "$@"
fi
