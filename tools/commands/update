#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : update
# Version     : reads VERSION
# Category    : Maintenance
# Requires    : bash git
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Run managed toolkit, system, and optional developer maintenance.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-config.sh"
source "$PROJECT_ROOT/lib/cc-dev-updates.sh"
source "$PROJECT_ROOT/lib/cc-results.sh"

MODE="dry-run"
MODE_SET=""
RUN_TOOLKIT=1
RUN_SYSTEM=1
RUN_KERNEL=1
RUN_HEALTH=1
RUN_DEV=0
DEV_TARGET="all"

usage() {
    cat <<'EOF_HELP'
Usage:
  cc update [--dry-run|--apply] [--toolkit-only|--system-only|--health-only]
  cc update dev [all|npm|pipx|pip|cargo|go|gem] [--dry-run|--apply]
  cc update npm [--dry-run|--apply]

Default:
  cc update runs in --dry-run mode.

Workflow:
  1. toolkit-update       Preview or apply toolkit pull and shell-file installation.
  2. system-update        Run managed OS/app update workflow.
  3. kernel cleanup       Review obsolete kernels. Applies only with --apply.
  4. dev-update           Optional developer maintenance when explicitly enabled.
  5. verify               Verify repository structure and Bash syntax.
  6. doctor               Run toolkit health checks.
  7. drives / smart       Show storage inventory and SMART summary.
  8. status               Show repository status.

Notes:
  All mutation-capable stages receive an explicit --apply from this command.
  Use cc toolkit-update --dry-run to preview toolkit maintenance only.
  Use cc system-update --dry-run to preview package/app updates only.
  Use cc update dev --dry-run before applying developer package updates.
  Set DEV_UPDATES=yes in cc config to include developer updates in cc update --apply.
  Use cc kernel cleanup separately before trusting automated cleanup.
EOF_HELP
}

case "${1:-}" in
    dev|developer|developers)
        RUN_TOOLKIT=0; RUN_SYSTEM=0; RUN_KERNEL=0; RUN_HEALTH=0; RUN_DEV=1
        shift
        if cc_dev_update_selector_valid "${1:-all}"; then
            DEV_TARGET="${1:-all}"
            [ "$#" -eq 0 ] || shift
        fi
        ;;
    npm|pipx|pip|cargo|go|gem)
        RUN_TOOLKIT=0; RUN_SYSTEM=0; RUN_KERNEL=0; RUN_HEALTH=0; RUN_DEV=1
        DEV_TARGET="$1"
        shift
        ;;
esac

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --version)
            cc_version
            exit 0
            ;;
        --dry-run)
            if [ -n "$MODE_SET" ] && [ "$MODE_SET" != dry-run ]; then
                cc_error "Choose exactly one of --dry-run or --apply."
                exit 2
            fi
            MODE="dry-run"
            MODE_SET="dry-run"
            shift
            ;;
        --apply)
            if [ -n "$MODE_SET" ] && [ "$MODE_SET" != apply ]; then
                cc_error "Choose exactly one of --dry-run or --apply."
                exit 2
            fi
            MODE="apply"
            MODE_SET="apply"
            shift
            ;;
        --toolkit-only)
            RUN_TOOLKIT=1; RUN_SYSTEM=0; RUN_KERNEL=0; RUN_HEALTH=0; RUN_DEV=0
            shift
            ;;
        --system-only)
            RUN_TOOLKIT=0; RUN_SYSTEM=1; RUN_KERNEL=1; RUN_HEALTH=0; RUN_DEV=0
            shift
            ;;
        --health-only)
            RUN_TOOLKIT=0; RUN_SYSTEM=0; RUN_KERNEL=0; RUN_HEALTH=1; RUN_DEV=0
            shift
            ;;
        *)
            usage
            exit 2
            ;;
    esac
done

run_cc() {
    local name="$1"
    shift
    echo
    echo "============================================================"
    echo "cc $name $*"
    echo "============================================================"
    CC_SEMANTIC_RESULT=1 "${CC_UPDATE_RUNNER:-bash}" "$PROJECT_ROOT/tools/cc" "$name" "$@"
}

run_stage() {
    local label="$1" rc state
    shift
    if "$@"; then rc=0; else rc=$?; fi
    state="$(cc_result_from_rc "$rc")"
    cc_result_record "$label" "$state"
    return 0
}

skip_stage() { cc_result_record "$1" SKIP; }

run_dev_update() {
    if [ "$MODE" = "apply" ]; then
        run_cc dev-update "$DEV_TARGET" --apply
    else
        run_cc dev-update "$DEV_TARGET" --dry-run
    fi
}

cc_banner
echo "Maintenance mode: $MODE"
cc_result_reset

if [ "$RUN_TOOLKIT" -eq 1 ]; then
    if [ "$MODE" = "apply" ]; then
        run_stage "Toolkit update" run_cc toolkit-update --apply
    else
        run_stage "Toolkit update" run_cc toolkit-update --dry-run
    fi
else skip_stage "Toolkit update"; fi

if [ "$RUN_SYSTEM" -eq 1 ]; then
    if [ "$MODE" = "apply" ]; then
        run_stage "System update" run_cc system-update --apply
    else
        run_stage "System update" run_cc system-update --dry-run
    fi
else skip_stage "System update"; fi

if [ "$RUN_KERNEL" -eq 1 ]; then
    if [ "$MODE" = "apply" ]; then
        run_stage "Kernel cleanup" run_cc kernel cleanup --apply
    else
        run_stage "Kernel cleanup" run_cc kernel cleanup --dry-run
    fi
else skip_stage "Kernel cleanup"; fi

if [ "$RUN_DEV" -eq 1 ]; then
    run_stage "Developer updates" run_dev_update
elif [ "$RUN_TOOLKIT" -eq 1 ] && [ "$RUN_SYSTEM" -eq 1 ] && [ "$RUN_KERNEL" -eq 1 ]; then
    if cc_dev_update_truthy "$(cc_config_get DEV_UPDATES no)"; then
        run_stage "Developer updates" run_dev_update
    else
        skip_stage "Developer updates"
    fi
else
    skip_stage "Developer updates"
fi

if [ "$RUN_HEALTH" -eq 1 ]; then
    run_stage "Repository verify" run_cc verify
    run_stage "Doctor" run_cc doctor
    run_stage "Storage inventory" run_cc drives
    run_stage "SMART" run_cc smart
    run_stage "Repository status" run_cc status
else
    skip_stage "Repository verify"
    skip_stage "Doctor"
    skip_stage "Storage inventory"
    skip_stage "SMART"
    skip_stage "Repository status"
fi

echo
echo "Maintenance workflow result: $(cc_result_overall)"
printf 'PASS=%s WARN=%s FAIL=%s SKIP=%s\n' "$CC_RESULT_PASS" "$CC_RESULT_WARN" "$CC_RESULT_FAIL" "$CC_RESULT_SKIP"
cc_result_exit_status
