#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : plugin
# Version     : reads VERSION
# Category    : Core
# Requires    : bash find sort stat
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Inspect plugins and explicitly run one validated entrypoint.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-plugins.sh"

ACTION="${1:-list}"
NAME="${2:-}"

usage() {
    cat <<'EOF_HELP'
Usage:
  cc plugin [list|status]
  cc plugin info ID
  cc plugin run ID OPERATION [ARGUMENT ...]

Actions:
  list        List repository and current-host plugins with semantic state.
  status      Alias for list.
  info ID     Show validated inventory detail for one plugin ID.
  run         Revalidate and explicitly execute one exact plugin entrypoint.

Discovery reads data-only plugin.conf manifests. It never sources or executes
plugin entrypoints. Runtime does not use PATH entrypoint lookup, eval, shell
command strings, sourcing, sudo, dependency installation, or lifecycle hooks.
EOF_HELP
}

case "$ACTION" in
    --help|-h) usage; exit 0 ;;
    --version) cc_version; exit 0 ;;
    list|status) [ "$#" -le 1 ] || { usage; exit 2; } ;;
    info) [ -n "$NAME" ] && [ "$#" -eq 2 ] || { usage; exit 2; } ;;
    run) [ -n "$NAME" ] && [ "$#" -ge 3 ] || { usage; exit 2; } ;;
    *) usage; exit 2 ;;
esac

plugin_table() {
    local id name state version provides origin path reason entrypoint found=0
    printf '%-24s %-6s %-12s %-10s %s\n' Plugin State Version Origin Provides
    printf '%-24s %-6s %-12s %-10s %s\n' ------ ----- ------- ------ --------
    while IFS=$'\t' read -r id name state version provides origin path reason entrypoint; do
        [ -n "$id" ] || continue
        found=1
        printf '%-24s %-6s %-12s %-10s %s\n' "$id" "$state" "$version" "$origin" "$provides"
        [ "$state" = PASS ] || printf '  %s\n' "$reason"
    done < <(cc_plugin_inventory_tsv)
    [ "$found" -eq 1 ] || printf '%s\n' 'No plugins discovered.'
}

plugin_info() {
    local id name state version provides origin path reason entrypoint found=0 duplicate=0
    while IFS=$'\t' read -r id name state version provides origin path reason entrypoint; do
        [ "$id" = "$NAME" ] || continue
        if [ "$found" -eq 1 ]; then duplicate=1; fi
        found=1
        printf '%-14s %s\n' ID "$id"
        printf '%-14s %s\n' Name "$name"
        printf '%-14s %s\n' State "$state"
        printf '%-14s %s\n' Version "$version"
        printf '%-14s %s\n' Origin "$origin"
        printf '%-14s %s\n' Provides "$provides"
        printf '%-14s %s\n' Path "$path"
        printf '%-14s %s\n' Entrypoint "${entrypoint:--}"
        printf '%-14s %s\n' Detail "$reason"
    done < <(cc_plugin_inventory_tsv)
    [ "$found" -eq 1 ] || { cc_error "Plugin not found: $NAME"; return 1; }
    [ "$duplicate" -eq 0 ] || return 1
}

case "$ACTION" in
    list|status) plugin_table ;;
    info) plugin_info ;;
    run) cc_plugin_run "$NAME" "${@:3}" ;;
esac
