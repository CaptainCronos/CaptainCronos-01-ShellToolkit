#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : desktop-reload
# Version     : reads VERSION
# Category    : Maintenance
# Requires    : bash cinnamon mktemp stat
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Reload the Cinnamon desktop shell without ending the X11 session.
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
source "$PROJECT_ROOT/lib/cc-common.sh"

usage() {
    cat <<'EOF_HELP'
Usage:
  cc desktop-reload

Reloads the Cinnamon desktop shell in the current X11 session without logging
out. This can restore tray/status icons that fail to register at login.

The command refuses to run outside Cinnamon, outside X11, or without an active
X display. Its Cinnamon output is retained in a private, session-scoped log.
EOF_HELP
}

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    --version)
        cc_version
        exit 0
        ;;
    "")
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

desktop="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-unknown}}"
case "${desktop,,}" in
    *cinnamon*) ;;
    *)
        cc_error "desktop-reload supports Cinnamon only. Current desktop: $desktop"
        exit 1
        ;;
esac

if [ "${XDG_SESSION_TYPE,,}" != "x11" ]; then
    cc_error "desktop-reload requires an X11 session. Current session: ${XDG_SESSION_TYPE:-unknown}"
    exit 1
fi

[ -n "${DISPLAY:-}" ] || {
    cc_error "desktop-reload requires an active X11 display."
    exit 1
}

if ! command -v cinnamon >/dev/null 2>&1; then
    cc_error "Missing required command: cinnamon"
    exit 1
fi

RUNTIME_DIR="${XDG_RUNTIME_DIR:-}"
if [ -z "$RUNTIME_DIR" ] || [ ! -d "$RUNTIME_DIR" ] || [ -L "$RUNTIME_DIR" ] || [ ! -O "$RUNTIME_DIR" ]; then
    cc_error "desktop-reload requires a private XDG_RUNTIME_DIR owned by the current user."
    exit 1
fi

# Create a unique mode-600 log before launching Cinnamon.  Unlike a fixed file
# below /tmp, this cannot overwrite an attacker-controlled path and is scoped
# to the active graphical login.  Unregister it so the diagnostic survives the
# short-lived launcher process.
cc_temp_file LOG_FILE "$RUNTIME_DIR/captaincronos-cinnamon-replace.XXXXXX.log" || {
    cc_error "Unable to create Cinnamon reload log under: $RUNTIME_DIR"
    exit 1
}
cc_temp_unregister "$LOG_FILE"

cc_log "Reloading Cinnamon desktop shell..."
nohup cinnamon --replace </dev/null >"$LOG_FILE" 2>&1 &
PID=$!
cc_log "Reload requested (PID: $PID). Log: $LOG_FILE"
