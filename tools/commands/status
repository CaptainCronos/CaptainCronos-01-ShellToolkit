#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : status
# Version     : reads VERSION
# Category    : Repository
# Requires    : bash git
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Show repository status summary.
# ==============================================================================

set -euo pipefail

ORIGINAL_PWD="${PWD:-$(pwd)}"
TOOLKIT_ROOT="${TOOLKIT_ROOT:-${PROJECT_ROOT:-}}"
if [ -z "$TOOLKIT_ROOT" ]; then
    TOOLKIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fi

cd "$TOOLKIT_ROOT"
source "$TOOLKIT_ROOT/lib/cc-context.sh"
source "$TOOLKIT_ROOT/lib/cc-common.sh"
cc_context_init "$TOOLKIT_ROOT" "${CURRENT_REPO:-$ORIGINAL_PWD}"

case "${1:-}" in
    --help|-h)
        echo "Usage: cc status"
        echo
        echo "Shows branch, origin, recent commits, and working tree status."
        exit 0
        ;;
    --version)
        cc_version
        exit 0
        ;;
esac
[ "$#" -eq 0 ] || { echo "Usage: cc status" >&2; exit 2; }

cc_banner
REPO_ROOT="$(cc_current_repo)"
if ! cc_repo_is_git "$REPO_ROOT"; then
    cc_error "Not a Git repository: $REPO_ROOT"
    exit 1
fi
printf '%-14s %s\n' "Repository:" "$REPO_ROOT"
printf '%-14s %s\n' "Branch:" "$(cc_repo_head_display "$REPO_ROOT")"
printf '%-14s %s\n' "Origin:" "$(cc_repo_remote "$REPO_ROOT" origin 2>/dev/null || echo none)"
echo
echo "Recent commits"
echo "--------------"
git -C "$REPO_ROOT" log --oneline -5 2>/dev/null || echo "none"
echo
echo "Working tree"
echo "------------"
if [ -n "$(git -C "$REPO_ROOT" status --short)" ]; then
    git -C "$REPO_ROOT" status --short
    [ "${CC_SEMANTIC_RESULT:-0}" != 1 ] || exit 10
else
    echo "clean"
fi
