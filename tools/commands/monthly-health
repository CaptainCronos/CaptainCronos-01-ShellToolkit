#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : monthly-health
# Version     : reads VERSION
# Category    : Maintenance
# Requires    : bash date mkdir df uname uptime find sort
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Generate a monthly host health and maintenance report.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-kernel.sh"
source "$PROJECT_ROOT/lib/cc-network.sh"
source "$PROJECT_ROOT/lib/cc-services.sh"
source "$PROJECT_ROOT/lib/cc-results.sh"

OUTPUT="file"
JOURNAL_SINCE="${JOURNAL_SINCE:-24 hours ago}"
TOP_N="${TOP_N:-5}"
REPORT_DIR="$HOME/.captaincronos/reports/monthly-health"
STAMP="$(date +%Y%m%d-%H%M%S)"
REPORT_FILE="$REPORT_DIR/monthly-health-$STAMP.log"
LATEST_LINK="$REPORT_DIR/latest.log"

usage() {
    cat <<'EOF_HELP'
Usage:
  cc monthly-health [--stdout] [--file]

Generates a host health and maintenance report.
Kernel health, platform, boot storage, and maintenance fields come from the
shared semantic kernel snapshot; no kernel cleanup is performed.

Default output:
  ~/.captaincronos/reports/monthly-health/monthly-health-YYYYMMDD-HHMMSS.log

Environment:
  JOURNAL_SINCE="7 days ago" cc monthly-health
  TOP_N=10 cc monthly-health --stdout
EOF_HELP
}

section() {
    echo
    echo "============================================================"
    echo "$1"
    echo "============================================================"
    echo
}

subsection() {
    echo
    echo "-- $1 --"
}

have() { command -v "$1" >/dev/null 2>&1; }

redact_report() {
    local user_name="${USER:-}" home_path="${HOME:-}" root_path="$PROJECT_ROOT"
    sed -E \
        -e 's#(https?://)[^/@[:space:]]+:[^/@[:space:]]+@#\1[REDACTED]@#g' \
        -e 's#([Aa]uthorization:)[[:space:]]*[^[:space:]]+([[:space:]]+[^[:space:]]+)?#\1 [REDACTED]#g' \
        -e 's#([Cc]ookie:|[Ss]et-[Cc]ookie:)[[:space:]]*.*#\1 [REDACTED]#g' \
        -e 's#((token|secret|password|passwd|api[_-]?key)=)[^&[:space:]]+#\1[REDACTED]#Ig' \
        -e "s#${root_path//\#/\\#}#[TOOLKIT_ROOT]#g" \
        -e "s#${home_path//\#/\\#}#[HOME]#g" \
        ${user_name:+-e "s#\\b${user_name//\#/\\#}\\b#[USER]#g"}
}

run_health_section() {
    local label="$1" rc state output
    shift
    output="$(mktemp "${TMPDIR:-/tmp}/cc-monthly-section.XXXXXX")" || return 1
    chmod 600 "$output"
    if "$@" >"$output" 2>&1; then rc=0; else rc=$?; fi
    redact_report <"$output"
    rm -f "$output"
    state="$(cc_result_from_rc "$rc")"
    cc_result_record "$label" "$state"
}

service_status() {
    local unit="$1"
    printf '%-24s %s\n' "$unit" "$(_cc_service_status system "$unit")"
}

mount_check() {
    local path="$1"
    if [ -e "$path" ] && mountpoint -q "$path" 2>/dev/null; then
        printf '%-24s %s\n' "$path" "mounted"
    elif [ -e "$path" ]; then
        printf '%-24s %s\n' "$path" "exists-not-mounted"
    else
        printf '%-24s %s\n' "$path" "missing"
    fi
}

print_kernel_health() {
    local status severity code message candidates reboot_state maintenance
    section "Kernel Health"
    if ! _cc_kernel_snapshot_capture "${KEEP_COUNT:-2}"; then
        printf '%-28s %s\n' "Overall health:" "WARN"
        printf '%-28s %s\n' "Inspection:" "semantic snapshot unavailable"
        return "$CC_RESULT_WARN_RC"
    fi

    status="$(_cc_kernel_snapshot_get health_status)"
    printf '%-28s %s\n' "Overall health:" "$status"
    printf '%-28s %s\n' "Running kernel:" "$(_cc_kernel_snapshot_get running)"
    printf '%-28s %s\n' "Newest installed kernel:" "$(_cc_kernel_snapshot_get newest)"
    printf '%-28s %s\n' "Running is newest:" "$(_cc_kernel_snapshot_get running_is_newest)"
    printf '%-28s %s\n' "Reboot state:" "$(_cc_kernel_snapshot_get reboot_state)"

    subsection "Platform"
    printf '%-28s %s\n' "OS:" "$(_cc_kernel_snapshot_get os)"
    printf '%-28s %s\n' "Distribution family:" "$(_cc_kernel_snapshot_get distribution_family)"
    printf '%-28s %s\n' "Kernel package model:" "$(_cc_kernel_snapshot_get package_model)"
    printf '%-28s %s\n' "Initramfs provider:" "$(_cc_kernel_snapshot_get initramfs_provider)"
    printf '%-28s %s\n' "Bootloader:" "$(_cc_kernel_snapshot_get bootloader)"
    printf '%-28s %s\n' "EFI filesystem:" "$(_cc_kernel_snapshot_get efi_filesystem_state)"
    printf '%-28s %s\n' "EFI runtime:" "$(_cc_kernel_snapshot_get efi_runtime_state)"

    subsection "Kernel Inventory"
    printf '%-28s %s\n' "Installed kernels:" "$(_cc_kernel_snapshot_get installed_count)"
    printf '%-28s %s\n' "Protected kernels:" "$(_cc_kernel_snapshot_get protected_count)"
    candidates="$(_cc_kernel_snapshot_get cleanup_candidate_count)"
    printf '%-28s %s\n' "Cleanup candidates:" "$candidates"

    subsection "Boot Storage"
    printf '%-28s %s mounted at %s\n' "Boot filesystem:" \
        "$(_cc_kernel_snapshot_get boot_filesystem)" "$(_cc_kernel_snapshot_get boot_filesystem_mount)"
    printf '%-28s %s\n' "Boot filesystem usage:" "$(_cc_kernel_snapshot_get boot_filesystem_usage)"
    printf '%-28s %s\n' "/boot artifact allocation:" "$(_cc_kernel_snapshot_get boot_artifact_usage)"
    printf '%-28s %s\n' "EFI usage:" "$(_cc_kernel_snapshot_get efi_usage)"

    subsection "Artifact Health"
    printf '%-28s %s\n' "Matched:" "$(_cc_kernel_snapshot_get artifact_matched)"
    printf '%-28s %s\n' "Partial:" "$(_cc_kernel_snapshot_get artifact_partial)"
    printf '%-28s %s\n' "Unmatched:" "$(_cc_kernel_snapshot_get artifact_unmatched)"
    printf '%-28s %s\n' "Missing:" "$(_cc_kernel_snapshot_get artifact_missing)"
    printf '%-28s %s\n' "Unknown:" "$(_cc_kernel_snapshot_get artifact_unknown)"

    subsection "Health Findings"
    while IFS=$'\t' read -r severity code message; do
        printf '%-6s %-34s %s\n' "$severity" "$code" "$message"
    done < <(_cc_kernel_snapshot_findings)

    subsection "Maintenance"
    maintenance=none
    if [ "$candidates" -gt 0 ]; then maintenance="old kernel cleanup available"; fi
    reboot_state="$(_cc_kernel_snapshot_get reboot_state)"
    case "$reboot_state" in
        required)
            if [ "$maintenance" = none ]; then maintenance="reboot recommended"
            else maintenance+="; reboot recommended"
            fi
            ;;
        newer-kernel-installed)
            if [ "$maintenance" = none ]; then maintenance="newer kernel installed"
            else maintenance+="; newer kernel installed"
            fi
            ;;
    esac
    printf '%-28s %s\n' "Maintenance advisory:" "${maintenance# }"
    case "$status" in
        FAIL) return 1 ;;
        WARN) return "$CC_RESULT_WARN_RC" ;;
        *) return 0 ;;
    esac
}

print_header() {
    section "Captain Cronos Monthly Health Report"
    printf '%-20s %s\n' "Generated:" "$(date)"
    printf '%-20s %s\n' "Host:" "$(hostname 2>/dev/null || echo unknown)"
    printf '%-20s %s\n' "Kernel:" "$(uname -r 2>/dev/null || echo unknown)"
    printf '%-20s %s\n' "User:" "${USER:-unknown}"
    printf '%-20s %s\n' "Toolkit root:" "$PROJECT_ROOT"
    printf '%-20s %s\n' "Toolkit version:" "$(bash "$PROJECT_ROOT/tools/cc" version 2>/dev/null | awk '/Toolkit/ {print $3; exit}' || echo unknown)"
}

print_basics() {
    local incomplete=0
    section "System Basics"
    subsection "Uptime and load"
    uptime || incomplete=1
    subsection "Memory"
    free -h || incomplete=1
    subsection "VM tuning"
    for key in vm.swappiness vm.vfs_cache_pressure vm.dirty_background_ratio vm.dirty_ratio vm.compaction_proactiveness; do
        sysctl "$key" 2>/dev/null || incomplete=1
    done
    subsection "Top CPU"
    ps -eo user,pid,pcpu,pmem,vsz,rss,stat,start,time,comm --sort=-pcpu | head -n $((TOP_N + 1)) || incomplete=1
    subsection "Top Memory"
    ps -eo user,pid,pcpu,pmem,vsz,rss,stat,start,time,comm --sort=-pmem | head -n $((TOP_N + 1)) || incomplete=1
    [ "$incomplete" -eq 0 ] || return "$CC_RESULT_WARN_RC"
}

print_storage() {
    local incomplete=0
    section "Storage"
    subsection "Mount checks"
    for path in / /home /my_files /home_1 /timeshift-usb; do
        mount_check "$path"
    done
    subsection "Filesystems"
    df -hT | awk 'NR==1 || /^\/dev\//' || incomplete=1
    subsection "Block devices"
    lsblk -e 7 -o NAME,TYPE,SIZE,FSTYPE,LABEL,UUID,FSUSE%,MOUNTPOINTS 2>/dev/null || incomplete=1
    subsection "SMART"
    bash "$PROJECT_ROOT/tools/cc" smart 2>&1 || incomplete=1
    [ "$incomplete" -eq 0 ] || return 1
}

print_updates() {
    local incomplete=0
    section "Maintenance Update Readiness"
    subsection "Toolkit status"
    if CC_SEMANTIC_RESULT=1 bash "$PROJECT_ROOT/tools/cc" status 2>&1; then
        :
    elif [ "$?" -eq "$CC_RESULT_WARN_RC" ]; then
        incomplete=2
    else
        incomplete=1
    fi
    subsection "Doctor"
    if CC_DOCTOR_SKIP_KERNEL=1 CC_SEMANTIC_RESULT=1 bash "$PROJECT_ROOT/tools/cc" doctor 2>&1; then
        :
    elif [ "$?" -eq "$CC_RESULT_WARN_RC" ]; then
        [ "$incomplete" -eq 0 ] && incomplete=2
    else
        incomplete=1
    fi
    subsection "System update dry-run"
    bash "$PROJECT_ROOT/tools/cc" system-update --dry-run 2>&1 || incomplete=1
    case "$incomplete" in
        0) return 0 ;;
        2) return "$CC_RESULT_WARN_RC" ;;
        *) return 1 ;;
    esac
}

print_backups() {
    local incomplete=0
    section "Backup Systems"
    subsection "Timers"
    if _cc_service_manager_available; then
        _cc_service_list_timers system 2>/dev/null | grep -E 'NEXT|timeshift|bitcoin|backup|captain|monthly' || true
    fi
    subsection "Timeshift"
    if [ -x "$HOME/bin/timeshift-status.sh" ]; then
        "$HOME/bin/timeshift-status.sh" 2>&1 | sed -n '1,120p' || true
    else
        echo "timeshift-status.sh not found or not executable"
        incomplete=1
    fi
    subsection "Bitcoin backups"
    if [ -x "$HOME/bin/bitcoin-backup-status.sh" ]; then
        "$HOME/bin/bitcoin-backup-status.sh" 2>&1 | sed -n '1,160p' || true
    else
        echo "bitcoin-backup-status.sh not found or not executable"
        incomplete=1
    fi
    [ "$incomplete" -eq 0 ] || return "$CC_RESULT_SKIP_RC"
}

print_services() {
    section "Services"
    for unit in apache2 mariadb mysql bitcoind electrs fail2ban ufw; do
        service_status "$unit"
    done
    subsection "MariaDB socket/port"
    [ -S /run/mysqld/mysqld.sock ] || [ -S /var/run/mysqld/mysqld.sock ] && echo "mysql socket present" || echo "mysql socket missing"
    _cc_net_tcp_port_is_listening 3306 && echo "port 3306 listening" || echo "port 3306 not detected"
    _cc_service_manager_available || return "$CC_RESULT_WARN_RC"
}

print_security_network() {
    local incomplete=0
    section "Security and Network"
    subsection "UFW"
    if have ufw; then
        sudo ufw status verbose 2>/dev/null || ufw status verbose 2>/dev/null || true
    else
        echo "ufw not installed"
        incomplete=1
    fi
    subsection "Listening TCP ports"
    if _cc_net_sockets_available; then
        _cc_net_listeners 2>/dev/null || true
    else
        echo "socket inspection interface not available"
        incomplete=1
    fi
    subsection "Fail2Ban"
    if have fail2ban-client; then
        sudo fail2ban-client status 2>/dev/null || fail2ban-client status 2>/dev/null || true
    else
        echo "fail2ban-client not available"
        incomplete=1
    fi
    subsection "Network connectivity"
    ping -c 2 -W 2 8.8.8.8 >/dev/null 2>&1 && echo "internet reachable" || echo "internet check failed"
    [ "$incomplete" -eq 0 ] || return "$CC_RESULT_WARN_RC"
}

print_desktop_gpu() {
    section "Desktop and GPU"
    subsection "Display manager/session"
    _cc_service_default_target system 2>/dev/null || true
    printf '%-24s %s\n' "lightdm" "$(_cc_service_status system lightdm)"
    printf '%-24s %s\n' "gdm3" "$(_cc_service_status system gdm3)"
    echo "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unavailable}"
    echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-unavailable}"
    pgrep -x Xorg >/dev/null 2>&1 && echo "Xorg detected" || echo "Xorg not detected"
    pgrep -f wayland >/dev/null 2>&1 && echo "Wayland-related process detected" || echo "Wayland not detected"
    subsection "NVIDIA"
    if have nvidia-smi; then
        nvidia-smi || true
    else
        echo "nvidia-smi not found"
    fi
    return "$CC_RESULT_SKIP_RC"
}

print_logs() {
    section "Recent Logs"
    subsection "Important recent errors"
    if _cc_log_available; then
        _cc_log_since system "$JOURNAL_SINCE" 800 2>/dev/null | \
            grep -Ei 'fail(ed)?|error|segfault|denied|timed out|mariadb|apache2|bitcoind|electrs|timeshift|smart|kernel|nvidia' | \
            grep -Evi 'sshd.*Failed password|invalid user|maximum authentication attempts|apparmor="ALLOWED"' | \
            tail -n 50 || true
    else
        echo "system log interface not available"
        return "$CC_RESULT_SKIP_RC"
    fi
    subsection "SSH/auth noise"
    if _cc_log_available; then
        _cc_log_since system "$JOURNAL_SINCE" all 2>/dev/null | \
            grep -Ei 'sshd.*invalid user|Failed password|maximum authentication attempts' | tail -n 25 || true
    fi
}

print_footer() {
    section "Report Summary"
    echo "Overall report result: $(cc_result_overall)"
    printf 'PASS=%s WARN=%s FAIL=%s SKIP=%s\n' "$CC_RESULT_PASS" "$CC_RESULT_WARN" "$CC_RESULT_FAIL" "$CC_RESULT_SKIP"
    echo "Suggested follow-up commands:"
    echo "  cc update --dry-run"
    echo "  cc doctor --full"
    echo "  cc monthly-health --stdout"
}

generate_report() {
    cc_result_reset
    run_health_section "Report header" print_header
    run_health_section "Kernel" print_kernel_health
    run_health_section "System basics" print_basics
    run_health_section "Storage and SMART" print_storage
    run_health_section "Update preview and doctor" print_updates
    run_health_section "Backups" print_backups
    run_health_section "Services" print_services
    run_health_section "Networking and security" print_security_network
    run_health_section "Desktop and GPU" print_desktop_gpu
    run_health_section "Recent logs" print_logs
    print_footer
    cc_result_exit_status
}

monthly_health_main() {
    case "${1:-}" in
        --help|-h) usage; return 0 ;;
        --version) cc_version; return 0 ;;
        --stdout) OUTPUT=stdout ;;
        --file|"") OUTPUT="file" ;;
        *) usage; return 2 ;;
    esac

    if [ "$OUTPUT" = "stdout" ]; then
        generate_report | redact_report
    else
        local temporary rc=0
        umask 077
        mkdir -p "$REPORT_DIR"
        chmod 700 "$REPORT_DIR"
        temporary="$(mktemp "$REPORT_DIR/.monthly-health.XXXXXX")" || return 1
        chmod 600 "$temporary"
        generate_report | redact_report > "$temporary" || rc=$?
        chmod 600 "$temporary"
        mv "$temporary" "$REPORT_FILE"
        chmod 600 "$REPORT_FILE"
        ln -sfn "$REPORT_FILE" "$LATEST_LINK"
        cc_log "Monthly health report written: $REPORT_FILE"
        cc_log "Latest report link: $LATEST_LINK"
        return "$rc"
    fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    monthly_health_main "$@"
fi
