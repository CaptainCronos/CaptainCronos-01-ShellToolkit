#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : prompt
# Version     : 1.0.0-alpha1
# Category    : Prompt
# Requires    : bash awk find sort
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Run dynamic Prompt Engine templates.
# ==============================================================================

set -euo pipefail

ORIGINAL_PWD="${PWD:-$(pwd)}"
TOOLKIT_ROOT="${TOOLKIT_ROOT:-${PROJECT_ROOT:-}}"
if [ -z "$TOOLKIT_ROOT" ]; then
    TOOLKIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fi

cd "$TOOLKIT_ROOT"
source "$TOOLKIT_ROOT/lib/cc-context.sh"
source "$TOOLKIT_ROOT/lib/cc-common.sh"
source "$TOOLKIT_ROOT/lib/cc-prompt-engine.sh"
cc_context_init "$TOOLKIT_ROOT" "${CURRENT_REPO:-$ORIGINAL_PWD}"

COMMAND_VERSION="1.0.0-alpha1"
TEMPLATE_ID=""

declare -a TEMPLATE_IDS=()
declare -a TEMPLATE_TITLES=()
declare -a TEMPLATE_DESCRIPTIONS=()
declare -a TEMPLATE_CATEGORIES=()
declare -a TEMPLATE_TAGS=()

handle_interrupt() {
    echo >&2
    cc_warn "Prompt session cancelled."
    exit 130
}

trap handle_interrupt INT

usage() {
    cat <<'EOF_HELP'
Usage:
  cc prompt
  cc prompt TEMPLATE

Dynamic Prompt Engine:
  Discovers templates from templates/prompts/.
  Run without TEMPLATE to choose from the interactive template menu.
  TEMPLATE may be a template id or template title.

Navigation:
  previous  Move to the previous question.
  back      Move to the previous question.
  next      Keep the current answer and continue.
  help      Show help for the current menu or question.
  cancel    Exit without rendering.

After preview:
  1 Generate  Copy when supported and print the rendered prompt.
  2 Edit      Edit a collected answer and preview again.
  3 Cancel    Exit without generating.
EOF_HELP
}

lower_word() {
    printf '%s' "${1,,}"
}

required_label() {
    case "$1" in
        yes) echo "required" ;;
        *) echo "optional" ;;
    esac
}

load_template_menu() {
    local row id title description category tags

    TEMPLATE_IDS=()
    TEMPLATE_TITLES=()
    TEMPLATE_DESCRIPTIONS=()
    TEMPLATE_CATEGORIES=()
    TEMPLATE_TAGS=()

    cc_prompt_validate_templates

    while IFS=$'\t' read -r id title description category tags; do
        [ -n "$id" ] || continue
        TEMPLATE_IDS+=("$id")
        TEMPLATE_TITLES+=("$title")
        TEMPLATE_DESCRIPTIONS+=("$description")
        TEMPLATE_CATEGORIES+=("$category")
        TEMPLATE_TAGS+=("$tags")
    done < <(cc_prompt_template_menu_catalog)

    if [ "${#TEMPLATE_IDS[@]}" -eq 0 ]; then
        cc_error "No prompt templates discovered."
        return 1
    fi
}

print_template_menu() {
    local index

    echo >&2
    echo "Captain Cronos Prompt Engine" >&2
    echo "============================" >&2
    echo "Breadcrumbs: Prompt Engine > Templates" >&2
    echo >&2
    echo "Available Templates" >&2
    echo >&2
    for index in "${!TEMPLATE_IDS[@]}"; do
        printf '%2s. %s\n' "$((index + 1))" "${TEMPLATE_TITLES[$index]}" >&2
    done
    echo >&2
    printf 'Selection [number/id/title/help/cancel]: ' >&2
}

print_template_menu_help() {
    local index

    echo >&2
    echo "Template Help" >&2
    echo "=============" >&2
    for index in "${!TEMPLATE_IDS[@]}"; do
        printf '%2s. %s\n' "$((index + 1))" "${TEMPLATE_TITLES[$index]}" >&2
        printf '    ID: %s\n' "${TEMPLATE_IDS[$index]}" >&2
        printf '    Category: %s\n' "${TEMPLATE_CATEGORIES[$index]}" >&2
        printf '    Tags: %s\n' "${TEMPLATE_TAGS[$index]}" >&2
        printf '    %s\n' "${TEMPLATE_DESCRIPTIONS[$index]}" >&2
    done
    echo >&2
    echo "Choose by number, template id, or exact title. Use cancel to exit." >&2
}

template_index_for_selection() {
    local input="$1" selection index id title

    selection="$(lower_word "$input")"

    if [[ "$selection" =~ ^[0-9]+$ ]] &&
        [ "$selection" -ge 1 ] &&
        [ "$selection" -le "${#TEMPLATE_IDS[@]}" ]; then
        echo "$((selection - 1))"
        return 0
    fi

    for index in "${!TEMPLATE_IDS[@]}"; do
        id="$(lower_word "${TEMPLATE_IDS[$index]}")"
        title="$(lower_word "${TEMPLATE_TITLES[$index]}")"
        if [ "$selection" = "$id" ] || [ "$selection" = "$title" ]; then
            echo "$index"
            return 0
        fi
    done

    return 1
}

select_template_from_menu() {
    local input index

    while true; do
        print_template_menu
        if ! IFS= read -r input; then
            echo >&2
            cc_warn "Input ended before template selection."
            return 130
        fi

        case "$(lower_word "$input")" in
            help|h|\?)
                print_template_menu_help
                continue
                ;;
            cancel|q|quit|exit)
                echo ""
                return 0
                ;;
        esac

        if index="$(template_index_for_selection "$input")"; then
            echo "${TEMPLATE_IDS[$index]}"
            return 0
        fi

        cc_warn "Unknown prompt template: $input"
    done
}

resolve_template_argument() {
    local input="$1" index

    if index="$(template_index_for_selection "$input")"; then
        echo "${TEMPLATE_IDS[$index]}"
        return 0
    fi

    cc_error "Unknown prompt template: $input"
    return 1
}

answer_valid() {
    cc_prompt_session_validate_answer "$1"
}

print_question() {
    local index="$1" total title prompt required answer default

    total="$(cc_prompt_session_question_count)"
    title="$(cc_prompt_session_template_title)"
    prompt="$(cc_prompt_session_question_field "$index" prompt)"
    required="$(cc_prompt_session_question_field "$index" required)"
    answer="$(cc_prompt_session_question_field "$index" answer)"
    default="$(cc_prompt_session_question_field "$index" default)"

    echo >&2
    echo "Captain Cronos Prompt Engine" >&2
    echo "============================" >&2
    printf 'Template: %s (%s)\n' "$title" "$(cc_prompt_session_template)" >&2
    printf 'Breadcrumbs: Prompt Engine > %s > Question %s\n' "$title" "$((index + 1))" >&2
    printf 'Progress: %s/%s\n' "$((index + 1))" "$total" >&2
    printf '%s\n' "----------------" >&2
    printf '%s (%s)\n' "$prompt" "$(required_label "$required")" >&2
    cc_prompt_session_help_text "$index" >&2
    if [ -n "$answer" ]; then
        printf 'Current: %s\n' "$answer" >&2
    elif [ -n "$default" ]; then
        printf 'Default: %s\n' "$default" >&2
    fi
    printf 'Answer or command [previous/back/next/help/cancel]: ' >&2
}

read_answer() {
    local index="$1" input command

    print_question "$index"
    if ! IFS= read -r input; then
        echo >&2
        cc_warn "Input ended before prompt generation."
        return 130
    fi

    command="$(lower_word "$input")"
    case "$command" in
        previous|prev|back)
            echo "__COMMAND__:previous"
            return 0
            ;;
        next|"")
            echo "__COMMAND__:next"
            return 0
            ;;
        help|h|\?)
            echo "__COMMAND__:help"
            return 0
            ;;
        cancel|quit|exit)
            echo "__COMMAND__:cancel"
            return 0
            ;;
    esac

    echo "$input"
}

run_question_flow() {
    local result command

    cc_prompt_session_set_question "${1:-0}" || return $?

    while ! cc_prompt_session_complete; do
        local index
        index="$(cc_prompt_session_current_question)"
        result="$(read_answer "$index")" || return $?

        if [[ "$result" == __COMMAND__:* ]]; then
            command="${result#__COMMAND__:}"
            case "$command" in
                previous)
                    if ! cc_prompt_session_back; then
                        cc_warn "Already at the first question."
                    fi
                    ;;
                next)
                    if answer_valid "$index"; then
                        cc_prompt_session_next
                    else
                        cc_warn "Answer failed validation."
                    fi
                    ;;
                help)
                    echo >&2
                    cc_prompt_session_help_text "$index" >&2
                    ;;
                cancel)
                    cc_prompt_session_cancel
                    return 130
                    ;;
            esac
            continue
        fi

        cc_prompt_session_answer_set "$index" "$result"
        if answer_valid "$index"; then
            cc_prompt_session_next
        else
            cc_warn "Answer failed validation."
        fi
    done
}

edit_single_answer() {
    local index="$1" result command original_index

    original_index="$(cc_prompt_session_current_question)"
    cc_prompt_session_set_question "$index" || return $?

    while true; do
        result="$(read_answer "$index")" || return $?

        if [[ "$result" == __COMMAND__:* ]]; then
            command="${result#__COMMAND__:}"
            case "$command" in
                previous|next)
                    if answer_valid "$index"; then
                        cc_prompt_session_set_question "$original_index"
                        return 0
                    fi
                    cc_warn "Answer failed validation."
                    ;;
                help)
                    echo >&2
                    cc_prompt_session_help_text "$index" >&2
                    ;;
                cancel)
                    cc_prompt_session_cancel
                    return 130
                    ;;
            esac
            continue
        fi

        cc_prompt_session_answer_set "$index" "$result"
        if answer_valid "$index"; then
            cc_prompt_session_set_question "$original_index"
            return 0
        fi
        cc_warn "Answer failed validation."
    done
}

render_prompt() {
    cc_prompt_session_render
}

print_preview() {
    local rendered="$1"

    echo
    echo "Prompt Preview"
    echo "=============="
    printf 'Template: %s (%s)\n' "$(cc_prompt_session_template_title)" "$(cc_prompt_session_template)"
    echo "Breadcrumbs: Prompt Engine > $(cc_prompt_session_template_title) > Preview"
    echo
    printf '%s\n' "$rendered"
}

choose_edit_question() {
    local input index total prompt name
    total="$(cc_prompt_session_question_count)"

    echo >&2
    echo "Edit Answer" >&2
    echo "===========" >&2
    printf 'Template: %s (%s)\n' "$(cc_prompt_session_template_title)" "$(cc_prompt_session_template)" >&2
    echo "Breadcrumbs: Prompt Engine > $(cc_prompt_session_template_title) > Edit" >&2
    for ((index = 0; index < total; index++)); do
        prompt="$(cc_prompt_session_question_field "$index" prompt)"
        name="$(cc_prompt_session_question_field "$index" name)"
        printf '%2s. %s [%s]\n' "$((index + 1))" "$prompt" "$name" >&2
    done
    printf 'Field number, variable name, help, or cancel: ' >&2

    if ! IFS= read -r input; then
        echo >&2
        return 130
    fi

    case "$(lower_word "$input")" in
        help|h|\?)
            echo >&2
            echo "Choose the field number or variable name to edit. Existing answers are preserved until replaced." >&2
            choose_edit_question
            return $?
            ;;
        cancel|quit|exit|"") return 130 ;;
    esac

    if [[ "$input" =~ ^[0-9]+$ ]] && [ "$input" -ge 1 ] && [ "$input" -le "$total" ]; then
        echo "$((input - 1))"
        return 0
    fi

    for ((index = 0; index < total; index++)); do
        name="$(cc_prompt_session_question_field "$index" name)"
        if [ "$input" = "$name" ]; then
            echo "$index"
            return 0
        fi
    done

    cc_warn "Unknown field: $input"
    return 1
}

generate_choice() {
    local input

    echo >&2
    echo "Generate" >&2
    echo "========" >&2
    printf 'Template: %s (%s)\n' "$(cc_prompt_session_template_title)" "$(cc_prompt_session_template)" >&2
    echo "Breadcrumbs: Prompt Engine > $(cc_prompt_session_template_title) > Preview" >&2
    echo "1. Generate" >&2
    echo "2. Edit" >&2
    echo "3. Cancel" >&2
    printf 'Selection [1-3/help]: ' >&2

    if ! IFS= read -r input; then
        echo >&2
        return 130
    fi

    case "$(lower_word "$input")" in
        1|g|generate|y|yes|"") echo "yes" ;;
        2|e|edit) echo "edit" ;;
        3|c|cancel|quit|exit) echo "cancel" ;;
        help|h|\?)
            echo >&2
            echo "Generate copies the rendered prompt when a clipboard tool exists, then prints it. Edit returns to one saved answer." >&2
            generate_choice
            ;;
        *)
            cc_warn "Choose 1, 2, or 3."
            generate_choice
            ;;
    esac
}

copy_rendered_prompt() {
    local rendered="$1"

    if cc_prompt_clipboard_available; then
        if printf '%s\n' "$rendered" | cc_prompt_copy_to_clipboard; then
            cc_log "Rendered prompt copied to clipboard."
        else
            cc_warn "Clipboard command failed; rendered prompt was not copied."
        fi
    else
        cc_warn "Clipboard support not detected; rendered prompt was not copied."
    fi
}

run_prompt_template() {
    local template_id="$1"
    local rendered choice edit_index

    TEMPLATE_ID="$template_id"
    cc_prompt_session_start "$template_id"
    run_question_flow 0 || return $?

    while true; do
        rendered="$(render_prompt)"
        print_preview "$rendered"
        choice="$(generate_choice)" || return $?

        case "$choice" in
            yes)
                rendered="$(render_prompt)"
                copy_rendered_prompt "$rendered" >&2
                echo
                printf '%s\n' "$rendered"
                return 0
                ;;
            edit)
                edit_index="$(choose_edit_question)" || return $?
                edit_single_answer "$edit_index" || return $?
                ;;
            cancel)
                return 130
                ;;
        esac
    done
}

run_prompt_command() {
    local selected_template=""

    load_template_menu

    case "$#" in
        0)
            selected_template="$(select_template_from_menu)" || return $?
            [ -n "$selected_template" ] || return 0
            ;;
        1)
            selected_template="$(resolve_template_argument "$1")" || return $?
            ;;
        *)
            usage
            return 1
            ;;
    esac

    run_prompt_template "$selected_template"
}

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    --version)
        echo "prompt $COMMAND_VERSION"
        cc_version
        exit 0
        ;;
    *)
        run_prompt_command "$@"
        ;;
esac
