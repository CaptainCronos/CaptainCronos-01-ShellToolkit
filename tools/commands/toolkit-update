#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : toolkit-update
# Version     : reads VERSION
# Category    : Core
# Requires    : bash git
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Pull latest toolkit changes and reinstall local command files.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"

case "${1:-}" in
    --help|-h)
        cat <<'EOF_HELP'
Usage:
  cc toolkit-update [--dry-run|--apply]

Default:
  Dry-run. Reports the local repository state and planned installation without
  fetching, pulling, changing Git refs, creating backups, or installing files.

Options:
  --dry-run  Preview toolkit update and installation.
  --apply    Pull origin/main and run the full installer with explicit apply.
EOF_HELP
        exit 0
        ;;
    --version)
        cc_version
        exit 0
        ;;
esac

exec bash install/update.sh "$@"
