#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : roadmap
# Version     : reads VERSION
# Category    : Documentation
# Requires    : bash cat
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Show the canonical project roadmap from ROADMAP.md.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"

usage() {
    cat <<'EOF_HELP'
Usage:
  cc roadmap [markdown]

Shows the canonical project roadmap from ROADMAP.md.
EOF_HELP
}

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    --version)
        cc_version
        exit 0
        ;;
    markdown)
        cat ROADMAP.md
        exit 0
        ;;
esac

if command -v bat >/dev/null 2>&1; then
    bat --style=plain ROADMAP.md
else
    cat ROADMAP.md
fi
