#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : docs
# Version     : reads VERSION
# Category    : Documentation
# Requires    : bash git find awk
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Generate toolkit documentation and command references.
# ==============================================================================

set -euo pipefail

# A caller's BASH_ENV can import exported functions before this script starts,
# so sanitizing only individual capture children is too late: generation itself
# invokes Bash for syntax checks. Re-exec once with an explicit environment.
if [ "${CC_DOCS_SANITIZED:-0}" != 1 ]; then
    docs_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
    /usr/bin/env -i \
        PATH="${PATH:-}" HOME="${HOME:-}" TMPDIR="${TMPDIR:-}" \
        LC_ALL=C TERM=dumb NO_COLOR=1 CC_COLOR_MODE=never \
        CC_DOCS_SANITIZED=1 bash "$docs_script" "$@"
    exit $?
fi

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-metadata.sh"

ACTION="build"
OUT_DIR="$PROJECT_ROOT/docs/generated"
APPLY=0

usage() {
    cat <<'EOF_HELP'
Usage:
  cc docs [build|inventory|reference|changelog|lint|check] [--apply] [--out DIR]

Actions:
  inventory  Generate command inventory.
  reference  Generate command reference from command help output.
  changelog  Generate recent Git history summary.
  lint       Check command headers and Bash syntax.
  build      Generate all documentation outputs.
  check      Verify committed generated documents are current; never writes them.

Options:
  --apply    Write generated files under docs/generated.
  --out DIR  Override output directory.
EOF_HELP
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --version) cc_version; exit 0 ;;
        --apply) APPLY=1; shift ;;
        --out) shift; OUT_DIR="${1:-}"; [ -n "$OUT_DIR" ] || { usage; exit 1; }; shift ;;
        build|inventory|reference|changelog|lint|check) ACTION="$1"; shift ;;
        *) usage; exit 1 ;;
    esac
done

command_list() {
    find "$PROJECT_ROOT/tools/commands" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | LC_ALL=C sort
}

script_field() {
    local file="$1" field="$2"
    awk -v field="$field" '
        $0 ~ "^# " field "[[:space:]]*:" {
            sub("^# " field "[[:space:]]*:[[:space:]]*", "")
            print
            exit
        }
    ' "$file"
}

write_output() {
    local name="$1"
    shift
    if [ "$APPLY" -eq 1 ]; then
        local temporary status
        mkdir -p "$OUT_DIR"
        cc_temp_file temporary "$OUT_DIR/.${name}.XXXXXX" || return 1
        if "$@" > "$temporary"; then
            :
        else
            status=$?
            cc_temp_remove "$temporary" || :
            return "$status"
        fi
        if mv "$temporary" "$OUT_DIR/$name"; then
            :
        else
            status=$?
            cc_temp_remove "$temporary" || :
            return "$status"
        fi
        cc_temp_unregister "$temporary"
        cc_log "Generated: $OUT_DIR/$name"
    else
        "$@"
    fi
}

generate_inventory() {
    local cmd file version purpose contract class
    cc_load_version
    echo "# Captain Cronos Command Inventory"
    echo
    echo "Toolkit version: ${TOOLKIT_VERSION:-unknown} (${TOOLKIT_CODENAME:-unknown})"
    echo
    echo "| Command | Class | Version | Purpose |"
    echo "|---|---|---|---|"
    while read -r cmd; do
        [ -n "$cmd" ] || continue
        file="$PROJECT_ROOT/tools/commands/$cmd"
        version="${TOOLKIT_VERSION:-unknown}"
        purpose="$(script_field "$file" "Purpose")"
        contract="$(cc_contract_command_row "$cmd")"
        IFS='|' read -r _ class _ <<< "$contract"
        [ -n "$version" ] || version="unknown"
        [ -n "$purpose" ] || purpose="unknown"
        echo "| cc $cmd | $class | $version | $purpose |"
    done < <(command_list)
}

generate_reference() {
    local cmd first=1
    echo "# Captain Cronos Command Reference"
    echo
    cc_load_version
    echo "Toolkit version: ${TOOLKIT_VERSION:-unknown} (${TOOLKIT_CODENAME:-unknown})"
    echo
    while read -r cmd; do
        [ -n "$cmd" ] || continue
        if [ "$first" -eq 0 ]; then
            echo
        fi
        first=0
        echo "## cc $cmd"
        echo
        echo "~~~text"
        if ! docs_reference_cc "$cmd" --help 2>&1; then
            printf 'Failed to render help for cc %s.\n' "$cmd" >&2
            return 1
        fi
        echo "~~~"
        echo
        echo "### Switch discovery"
        echo
        echo "~~~text"
        if ! docs_reference_cc "$cmd" switches; then
            printf 'Failed to render switch discovery for cc %s.\n' "$cmd" >&2
            return 1
        fi
        echo "~~~"
    done < <(command_list)
}

docs_reference_cc() {
    local reference_path reference_home
    reference_path="$PATH"
    reference_home="${HOME:-}"
    (
        # Generated command documentation is a repository artifact. Do not let
        # caller shell hooks, exported functions, user program mappings,
        # locale, or color settings alter captured help text or root selection.
        local function_name
        while IFS= read -r function_name; do
            unset -f "$function_name"
        done < <(compgen -A function)
        command env -i \
            PATH="$reference_path" HOME="$reference_home" \
            LC_ALL=C TERM=dumb NO_COLOR=1 CC_COLOR_MODE=never \
            CAPTAIN_CRONOS_TOOLKIT_ROOT="$PROJECT_ROOT" \
            bash "$PROJECT_ROOT/tools/cc" "$@"
    )
}

generate_changelog() {
    echo "# Recent Change Summary"
    echo
    echo "Generated from the canonical CHANGELOG.md release-history authority."
    echo
    cat "$PROJECT_ROOT/CHANGELOG.md"
}

generate_lint() {
    local cmd file issues=0
    echo "# Documentation Lint Report"
    echo
    echo "Source: tools/commands headers, CLI contracts, and Bash syntax"
    echo
    while read -r cmd; do
        [ -n "$cmd" ] || continue
        file="$PROJECT_ROOT/tools/commands/$cmd"
        grep -q '^# Script[[:space:]]*:' "$file" || { echo "WARN: cc $cmd missing Script header"; issues=$((issues + 1)); }
        grep -q '^# Version[[:space:]]*:' "$file" || { echo "WARN: cc $cmd missing Version header"; issues=$((issues + 1)); }
        grep -q '^# Purpose[[:space:]]*:' "$file" || { echo "WARN: cc $cmd missing Purpose header"; issues=$((issues + 1)); }
        bash -n "$file" 2>/dev/null || { echo "ERROR: cc $cmd has Bash syntax problem"; issues=$((issues + 1)); }
    done < <(command_list)
    if ! cmp -s \
        <(command_list) \
        <(cc_contract_commands | cut -d '|' -f1 | LC_ALL=C sort); then
        echo "ERROR: registered commands and CLI contracts differ"
        issues=$((issues + 1))
    fi
    echo
    echo "Issues: $issues"
    [ "$issues" -eq 0 ]
}

generate_index() {
    echo "# Generated Documentation Index"
    echo
    echo "Source: cc docs build --apply"
    echo
    echo "- COMMAND_INVENTORY.md"
    echo "- COMMAND_REFERENCE.md"
    echo "- CHANGE_SUMMARY.md"
    echo "- DOCS_LINT.md"
}

generate_all_into() {
    local destination="$1"
    mkdir -p "$destination" || return 1
    generate_inventory >"$destination/COMMAND_INVENTORY.md" || return 1
    generate_reference >"$destination/COMMAND_REFERENCE.md" || return 1
    generate_changelog >"$destination/CHANGE_SUMMARY.md" || return 1
    generate_lint >"$destination/DOCS_LINT.md" || return 1
    generate_index >"$destination/README.md" || return 1
}

check_freshness() {
    local temporary name stale=0 status=0
    cc_temp_dir temporary "${TMPDIR:-/tmp}/cc-docs-check.XXXXXX" || return 1
    if generate_all_into "$temporary"; then
        :
    else
        status=$?
        cc_temp_remove "$temporary" || :
        return "$status"
    fi
    for name in COMMAND_INVENTORY.md COMMAND_REFERENCE.md CHANGE_SUMMARY.md DOCS_LINT.md README.md; do
        if [ ! -f "$OUT_DIR/$name" ] || ! cmp -s "$temporary/$name" "$OUT_DIR/$name"; then
            cc_status_line "Generated $name" "FAIL"
            stale=1
        else
            cc_status_line "Generated $name" "PASS"
        fi
    done
    [ "$stale" -eq 0 ] || status=1
    cc_temp_remove "$temporary" || return 1
    return "$status"
}

cc_banner
printf '%-14s %s\n' "Action:" "$ACTION"
printf '%-14s %s\n' "Apply:" "$APPLY"
printf '%-14s %s\n' "Output:" "$OUT_DIR"
echo

case "$ACTION" in
    inventory) write_output COMMAND_INVENTORY.md generate_inventory ;;
    reference) write_output COMMAND_REFERENCE.md generate_reference ;;
    changelog) write_output CHANGE_SUMMARY.md generate_changelog ;;
    lint) write_output DOCS_LINT.md generate_lint ;;
    build)
        write_output COMMAND_INVENTORY.md generate_inventory
        write_output COMMAND_REFERENCE.md generate_reference
        write_output CHANGE_SUMMARY.md generate_changelog
        write_output DOCS_LINT.md generate_lint
        write_output README.md generate_index
        ;;
    check)
        [ "$APPLY" -eq 0 ] || { cc_error "cc docs check is read-only; omit --apply."; exit 2; }
        check_freshness
        ;;
esac
