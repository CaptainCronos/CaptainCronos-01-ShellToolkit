#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : selftest
# Version     : 1.0.0-alpha1
# Category    : Engineering
# Requires    : bash git awk grep
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Run the full toolkit engineering self-test suite.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-data.sh"

VERBOSE=0
JSON=0
PASSED=0
FAILED=0
RESULTS=""

usage() {
    cat <<'EOF_HELP'
Usage:
  cc selftest [--verbose] [--json]

Runs the toolkit engineering self-test suite.

Checks:
  - shared library syntax and load checks
  - prompt engine template validation
  - strict command audit
  - documentation lint
  - release check
  - registry load
  - about command load
  - roadmap command load
  - plugin status load

Options:
  --verbose  Show full command output.
  --json     Emit simple JSON summary.
EOF_HELP
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --version)
            echo "1.0.0-alpha1"
            exit 0
            ;;
        --verbose)
            VERBOSE=1
            shift
            ;;
        --json)
            JSON=1
            shift
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

run_check() {
    local label="$1"
    shift
    local output rc
    if [ "$VERBOSE" -eq 1 ]; then
        echo
        echo "$label"
        printf '%*s\n' "${#label}" '' | tr ' ' '-'
        if "$@"; then
            rc=0
        else
            rc=$?
        fi
    else
        output="$("$@" 2>&1)" && rc=0 || rc=$?
    fi

    if [ "$rc" -eq 0 ]; then
        PASSED=$((PASSED + 1))
        RESULTS="${RESULTS}${label}:PASS\n"
        [ "$JSON" -eq 1 ] || cc_status_line "$label" "PASS"
    else
        FAILED=$((FAILED + 1))
        RESULTS="${RESULTS}${label}:FAIL\n"
        [ "$JSON" -eq 1 ] || cc_status_line "$label" "FAIL"
        if [ "$VERBOSE" -eq 0 ] && [ -n "${output:-}" ]; then
            echo
            echo "$output"
            echo
        fi
    fi
}

check_library() {
    local lib="$1"
    local path="$PROJECT_ROOT/lib/$lib"

    [ -f "$path" ] || return 1
    bash -n "$path" || return 1
    bash -c "set -euo pipefail; source '$PROJECT_ROOT/lib/cc-common.sh'; source '$path'" >/dev/null
}

check_prompt_engine() {
    local rendered formatted

    # shellcheck disable=SC1091
    source "$PROJECT_ROOT/lib/cc-prompt-engine.sh"

    cc_prompt_engine_loaded || return 1
    cc_prompt_validate_templates || return 1
    cc_prompt_validate_answer feature feature_name "Prompt Engine Smoke" || return 1
    if cc_prompt_validate_answer feature feature_name "@invalid" >/dev/null 2>&1; then
        return 1
    fi

    cc_prompt_session_start feature || return 1
    [ "$(cc_prompt_session_question_count)" -eq 5 ] || return 1
    cc_prompt_session_answer_set 0 "Prompt Engine Smoke" || return 1
    cc_prompt_session_validate_answer 0 || return 1
    cc_prompt_session_next || return 1
    cc_prompt_session_back || return 1
    [ "$(cc_prompt_session_current_question)" -eq 0 ] || return 1
    [ "$(cc_prompt_session_answer_get 0)" = "Prompt Engine Smoke" ] || return 1

    rendered="$(
        cc_prompt_render feature \
            "feature_name=Prompt Engine Smoke" \
            "repository_context=Captain Cronos Shell Toolkit" \
            "objective=Render a metadata-discovered prompt template." \
            "constraints=Internal engine only." \
            "validation=cc selftest"
    )"

    printf '%s\n' "$rendered" | grep -q "Feature Implementation Prompt" || return 1
    printf '%s\n' "$rendered" | grep -q "Prompt Engine Smoke" || return 1

    if _cc_json_available; then
        formatted="$(
            cc_prompt_render_formatted feature json \
                "feature_name=Prompt Engine Smoke" \
                "repository_context=Captain Cronos Shell Toolkit" \
                "objective=Render a metadata-discovered prompt template." \
                "constraints=Internal engine only." \
                "validation=cc selftest"
        )"
        printf '%s\n' "$formatted" | grep -q '"template":"feature"'
    fi
}

if [ "$JSON" -eq 0 ]; then
    cc_banner
    echo
    echo "Captain Cronos Engineering Self-Test"
    echo "====================================="
    echo
fi

run_check "Common library" check_library cc-common.sh
run_check "Context library" check_library cc-context.sh
run_check "Config library" check_library cc-config.sh
run_check "Semantic dependencies" bash "$PROJECT_ROOT/tests/dependencies.sh"
run_check "Programs library" check_library cc-programs.sh
run_check "Packages library" check_library cc-packages.sh
run_check "Package operations" bash "$PROJECT_ROOT/tests/package-management.sh"
run_check "Network library" check_library cc-network.sh
run_check "Network interfaces" bash "$PROJECT_ROOT/tests/network.sh"
run_check "Services library" check_library cc-services.sh
run_check "Service operations" bash "$PROJECT_ROOT/tests/services.sh"
run_check "HTTP library" check_library cc-http.sh
run_check "HTTP interfaces" bash "$PROJECT_ROOT/tests/http.sh"
run_check "Data library" check_library cc-data.sh
run_check "Structured data" bash "$PROJECT_ROOT/tests/data.sh"
run_check "Configuration safety" bash "$PROJECT_ROOT/tests/config.sh"
run_check "Storage library" check_library cc-storage.sh
run_check "Storage inventory" bash "$PROJECT_ROOT/tests/storage.sh"
run_check "SMART library" check_library cc-smart.sh
run_check "SMART parsing" bash "$PROJECT_ROOT/tests/smart.sh"
run_check "Asset library" check_library cc-assets.sh
run_check "Asset safety" bash "$PROJECT_ROOT/tests/assets.sh"
run_check "YAML compatibility library" check_library cc-yaml.sh
run_check "Report library" check_library cc-report.sh
run_check "Prompt engine library" check_library cc-prompt-engine.sh
run_check "Prompt engine render" check_prompt_engine
run_check "Strict command audit" bash "$PROJECT_ROOT/tools/cc" audit --strict
run_check "Documentation lint" bash "$PROJECT_ROOT/tools/cc" docs lint
run_check "Release check" bash "$PROJECT_ROOT/tools/cc" release check
run_check "Registry load" bash "$PROJECT_ROOT/tools/cc" registry
run_check "About load" bash "$PROJECT_ROOT/tools/cc" about
run_check "Roadmap load" bash "$PROJECT_ROOT/tools/cc" roadmap
run_check "Plugin status load" bash "$PROJECT_ROOT/tools/cc" plugin status

if [ "$JSON" -eq 1 ]; then
    status="PASS"
    [ "$FAILED" -eq 0 ] || status="FAIL"
    # This is a jq expression, not a shell expression.
    # shellcheck disable=SC2016
    _cc_json_generate \
        '{status: $status, passed: $passed, failed: $failed}' \
        --compact-output \
        --arg status "$status" \
        --argjson passed "$PASSED" \
        --argjson failed "$FAILED"
else
    echo
    echo "------------------------------------"
    printf '%-14s %s\n' "Tests Passed:" "$PASSED"
    printf '%-14s %s\n' "Tests Failed:" "$FAILED"
    echo
    if [ "$FAILED" -eq 0 ]; then
        printf '%-16s ' "Overall Status:"
        cc_pass
        printf '\n'
    else
        printf '%-16s ' "Overall Status:"
        cc_fail
        printf '\n'
    fi
fi

[ "$FAILED" -eq 0 ]
