    local runner="$1"
    "$runner" "Common library" core check_library cc-common.sh
    "$runner" "Temporary-resource library" core check_library cc-temp.sh
    "$runner" "Persistent-retention library" core check_library cc-retention.sh
    "$runner" "Managed PATH library" core check_library cc-path.sh
    "$runner" "Diagnostics library" diagnostics check_library cc-diagnostics.sh
    "$runner" "Diagnostic behavior" diagnostics bash "$PROJECT_ROOT/tests/diagnostics.sh"
    "$runner" "Progress behavior" diagnostics bash "$PROJECT_ROOT/tests/progress.sh"
    "$runner" "Presentation behavior" presentation bash "$PROJECT_ROOT/tests/presentation.sh"
    "$runner" "Help presentation" presentation bash "$PROJECT_ROOT/tests/help.sh"
    "$runner" "Command switch discovery" presentation bash "$PROJECT_ROOT/tests/command-switches.sh"
    "$runner" "Shell helpers" shell bash "$PROJECT_ROOT/tests/shell-helpers.sh"
    "$runner" "Local validation workflow" engineering bash "$PROJECT_ROOT/tests/ccvalidate.sh"
    "$runner" "PATH environment behavior" shell bash "$PROJECT_ROOT/tests/path-environment.sh"
    "$runner" "Context library" core check_library cc-context.sh
    "$runner" "Config library" configuration check_library cc-config.sh
    "$runner" "Temporary-resource lifecycle" core bash "$PROJECT_ROOT/tests/temp-lifecycle.sh"
    "$runner" "Persistent-resource retention" maintenance bash "$PROJECT_ROOT/tests/retention.sh"
    "$runner" "Report lifecycle" maintenance bash "$PROJECT_ROOT/tests/reports.sh"
    "$runner" "Semantic dependencies" dependencies bash "$PROJECT_ROOT/tests/dependencies.sh"
    "$runner" "Plugin library" plugins check_library cc-plugins.sh
    "$runner" "Capability library" plugins check_library cc-capabilities.sh
    "$runner" "Plugin and capability foundation" plugins bash "$PROJECT_ROOT/tests/plugins.sh"
    "$runner" "Programs library" programs check_library cc-programs.sh
    "$runner" "Packages library" packages check_library cc-packages.sh
    "$runner" "Package operations" packages bash "$PROJECT_ROOT/tests/package-management.sh"
    "$runner" "Debian package-query robustness" packages bash "$PROJECT_ROOT/tests/package-query-robustness.sh"
    "$runner" "Kernel library" kernel check_library cc-kernel.sh
    "$runner" "Kernel management" kernel bash "$PROJECT_ROOT/tests/kernel.sh"
    "$runner" "Kernel package classification" kernel bash "$PROJECT_ROOT/tests/kernel-package-classification.sh"
    "$runner" "Kernel artifact health" kernel bash "$PROJECT_ROOT/tests/kernel-artifacts.sh"
    "$runner" "Kernel platform capabilities" kernel bash "$PROJECT_ROOT/tests/kernel-platform.sh"
    "$runner" "Kernel health integration" kernel bash "$PROJECT_ROOT/tests/kernel-health-integration.sh"
    "$runner" "Network library" network check_library cc-network.sh
    "$runner" "Network interfaces" network bash "$PROJECT_ROOT/tests/network.sh"
    "$runner" "Services library" services check_library cc-services.sh
    "$runner" "Service operations" services bash "$PROJECT_ROOT/tests/services.sh"
    "$runner" "HTTP library" http check_library cc-http.sh
    "$runner" "HTTP interfaces" http bash "$PROJECT_ROOT/tests/http.sh"
    "$runner" "Data library" data check_library cc-data.sh
    "$runner" "Structured data" data bash "$PROJECT_ROOT/tests/data.sh"
    "$runner" "Configuration safety" configuration bash "$PROJECT_ROOT/tests/config.sh"
    "$runner" "Configuration host profiles" configuration bash "$PROJECT_ROOT/tests/config-host.sh"
    "$runner" "Mutation safety contracts" maintenance bash "$PROJECT_ROOT/tests/safety-contracts.sh"
    "$runner" "Developer update contracts" maintenance bash "$PROJECT_ROOT/tests/dev-updates.sh"
    "$runner" "Maintenance operation contracts" maintenance bash "$PROJECT_ROOT/tests/maintenance-operations.sh"
    "$runner" "RC diagnostic integrity" maintenance bash "$PROJECT_ROOT/tests/rc-integrity.sh"
    "$runner" "Storage library" storage check_library cc-storage.sh
    "$runner" "Storage inventory" storage bash "$PROJECT_ROOT/tests/storage.sh"
    "$runner" "SMART library" smart check_library cc-smart.sh
    "$runner" "SMART parsing" smart bash "$PROJECT_ROOT/tests/smart.sh"
    "$runner" "Asset library" assets check_library cc-assets.sh
    "$runner" "Asset safety" assets bash "$PROJECT_ROOT/tests/assets.sh"
    "$runner" "YAML compatibility library" data check_library cc-yaml.sh
    "$runner" "Report library" reporting check_library cc-report.sh
    "$runner" "Prompt engine library" prompt check_library cc-prompt-engine.sh
    "$runner" "Prompt engine render" prompt check_prompt_engine
    if [ "${SELFTEST_SKIP_RELEASE_CHECK:-0}" != 1 ] &&
        [ "${CC_SELFTEST_SKIP_RELEASE_CHECK:-0}" != 1 ]; then
        "$runner" "Release check" engineering bash "$PROJECT_ROOT/tools/cc" release check
    fi
    "$runner" "Registry load" registry bash "$PROJECT_ROOT/tools/cc" registry
    "$runner" "About load" core bash "$PROJECT_ROOT/tools/cc" about
    "$runner" "Roadmap load" documentation bash "$PROJECT_ROOT/tools/cc" roadmap
    "$runner" "Plugin status load" plugins bash "$PROJECT_ROOT/tools/cc" plugin status
}

selftest_main() {
    local status integrity_status=0 accounted

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --help|-h)
                usage
                return 0
                ;;
            --version)
                cc_version
                return 0
                ;;
            --verbose)
                VERBOSE=1
                shift
                ;;
            --json)
                JSON=1
                shift
                ;;
            --debug)
                DEBUG=1
                shift
                ;;
            *)
                usage
                return 1
                ;;
        esac
    done

    [ "$DEBUG" -eq 0 ] || cc_debug_enable
    if [ "${CC_SELFTEST_SKIP_RELEASE_CHECK:-0}" = 1 ]; then
        SELFTEST_SKIP_RELEASE_CHECK=1
        # This is an orchestration directive, not test-wide ambient state.
        unset CC_SELFTEST_SKIP_RELEASE_CHECK
    else
        SELFTEST_SKIP_RELEASE_CHECK=0
    fi
    SELFTEST_TOTAL=0
    selftest_suite selftest_count

    SELFTEST_TEMP="$(mktemp -d)"
    cc_debug_kv "selftest temporary path" "$SELFTEST_TEMP"
    trap selftest_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    cc_progress_init "Captain Cronos Selftest" "$SELFTEST_TOTAL" "$JSON" TEST

    if [ "$JSON" -eq 0 ]; then
        cc_banner
        echo
        echo "Captain Cronos Engineering Self-Test"
        echo "====================================="
        echo
    fi

    selftest_suite run_check

    accounted=$((PASSED + FAILED))
    if [ "$CC_PROGRESS_TOTAL" -eq "$SELFTEST_TOTAL" ] &&
        [ "$CC_PROGRESS_COMPLETED" -eq "$SELFTEST_TOTAL" ] &&
        [ "$accounted" -eq "$CC_PROGRESS_COMPLETED" ]; then
        integrity_status=1
    else
        selftest_present \
            "[CC TEST ERROR] accounting mismatch: registered=$SELFTEST_TOTAL announced=$CC_PROGRESS_TOTAL executed=$CC_PROGRESS_COMPLETED accounted=$accounted"
    fi
    cc_debug_kv "tests registered" "$SELFTEST_TOTAL"
    cc_debug_kv "tests completed" "$CC_PROGRESS_COMPLETED"
    cc_debug_kv "tests accounted" "$accounted"

    status=PASS
    if [ "$FAILED" -ne 0 ] || [ "$integrity_status" -ne 1 ]; then
        status=FAIL
    fi

    if [ "$JSON" -eq 1 ]; then
        # This is a jq expression, not a shell expression.
        # shellcheck disable=SC2016
        _cc_json_generate \
            '{status: $status, registered: $registered, executed: $executed, passed: $passed, failed: $failed}' \
            --compact-output \
            --arg status "$status" \
            --argjson registered "$SELFTEST_TOTAL" \
            --argjson executed "$CC_PROGRESS_COMPLETED" \
            --argjson passed "$PASSED" \
            --argjson failed "$FAILED"
    else
        echo
        echo "------------------------------------"
        printf '%-18s %s\n' "Tests Registered:" "$SELFTEST_TOTAL"
        printf '%-18s %s\n' "Tests Executed:" "$CC_PROGRESS_COMPLETED"
        printf '%-18s %s\n' "Tests Passed:" "$PASSED"
        printf '%-18s %s\n' "Tests Failed:" "$FAILED"
        echo
        cc_summary_status "Overall Status:" "$status"
    fi

    [ "$status" = PASS ]
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    selftest_main "$@"
fi
