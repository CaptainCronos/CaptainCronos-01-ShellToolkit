#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : system-update
# Version     : reads VERSION
# Category    : Maintenance
# Requires    : bash pkg-manager
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Safely preview or apply operating-system and packaged-app updates.
# ==============================================================================

set -uo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT" || exit 1
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-dev-updates.sh"
source "$PROJECT_ROOT/lib/cc-packages.sh"
source "$PROJECT_ROOT/lib/cc-environment.sh"

cc_load_version
LOG="${LOG:-$(cc_env_log_dir)/system-update.log}"
MODE="dry-run"
MODE_SET=""
FAILED=0

usage() {
    echo "Usage: cc system-update [--dry-run|--apply]"
    echo
    echo "Safely previews or applies platform package, Snap, and Flatpak updates."
    echo
    echo "Default:"
    echo "  Dry-run. Persistent mutation requires explicit --apply."
    echo
    echo "Notes:"
    echo "  Developer package managers are detected and reported, but not updated by system-update."
    echo "  Automatic Firefox/Thunderbird archive replacement is deferred for v1.3 RC."
    echo "  CLI Safe Boot/GRUB mutation is not part of routine system updates."
    echo "  This command does not purge old kernels. Review kernel cleanup separately after this workflow is stable."
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --version)
            cc_version
            exit 0
            ;;
        --dry-run)
            if [ -n "$MODE_SET" ] && [ "$MODE_SET" != dry-run ]; then
                cc_error "Choose exactly one of --dry-run or --apply."
                exit 2
            fi
            MODE="dry-run"
            MODE_SET="dry-run"
            shift
            ;;
        --apply)
            if [ -n "$MODE_SET" ] && [ "$MODE_SET" != apply ]; then
                cc_error "Choose exactly one of --dry-run or --apply."
                exit 2
            fi
            MODE="apply"
            MODE_SET="apply"
            shift
            ;;
        *)
            cc_error "Unknown option: $1"
            usage >&2
            exit 2
            ;;
    esac
done

if [ "$MODE" = apply ]; then
    umask 077
    mkdir -p "$(dirname "$LOG")"
    chmod 700 "$(dirname "$LOG")"
    if ! : > "$LOG"; then
        cc_error "Unable to initialize update log: $LOG"
        exit 1
    fi
    chmod 600 "$LOG"
fi

say() {
    if [ "$MODE" = apply ]; then
        printf '%s\n' "$*" | tee -a "$LOG"
    else
        printf '%s\n' "$*"
    fi
}
have(){ command -v "$1" >/dev/null 2>&1; }

run_log() {
    if [ "$MODE" = dry-run ]; then
        say "DRY RUN: $*"
        return 0
    fi
    "$@" 2>&1 | tee -a "$LOG"
    return "${PIPESTATUS[0]}"
}

record_failure() {
    FAILED=$((FAILED + 1))
    if [ "$MODE" = apply ]; then
        printf '[CC ERROR] %s\n' "$1" >> "$LOG"
    fi
    cc_error "$1"
}

cc_banner
say "Starting system update (${TOOLKIT_VERSION:-unknown})..."

say
say "System Package Managers"
say "-----------------------"
if [ "$MODE" = dry-run ]; then
    package_dry_run=1
else
    package_dry_run=0
fi
CC_PKG_DRY_RUN="$package_dry_run" CC_PKG_RUNNER=run_log CC_PKG_REPORTER=say _cc_pkg_update || record_failure "Package index update failed."
CC_PKG_DRY_RUN="$package_dry_run" CC_PKG_RUNNER=run_log CC_PKG_REPORTER=say _cc_pkg_upgrade || record_failure "Package upgrade failed."

say
say "Desktop/App Package Managers"
say "----------------------------"
if have snap; then
    run_log sudo snap refresh || record_failure "Snap refresh failed."
else
    say "Snap: not installed; skipping."
fi

if have flatpak; then
    run_log flatpak update -y || record_failure "Flatpak update failed."
    run_log flatpak uninstall --unused -y || record_failure "Flatpak unused-package cleanup failed."
else
    say "Flatpak: not installed; skipping."
fi

say
say "Deferred RC Maintenance"
say "-----------------------"
say "Firefox archive replacement: deferred; no automatic download or install."
say "Thunderbird archive replacement: deferred; no automatic download or install."
say "CLI Safe Boot/GRUB refresh: deferred; routine system update does not modify boot configuration."

say
if [ -f "$HOME/myenv/bin/activate" ]; then
    say "Developer Python environment detected: $HOME/myenv"
    say "[CC] system-update does not update Python virtualenv packages automatically."
fi
if [ "$MODE" = apply ]; then
    cc_dev_update_report all 0 | tee -a "$LOG" || record_failure "Developer package-manager reporting failed."
else
    cc_dev_update_report all 0 || record_failure "Developer package-manager reporting failed."
fi
say "[CC] Developer package updates require: cc update dev --apply"

if [ "$FAILED" -gt 0 ]; then
    say "System update completed with $FAILED failure(s)."
    cc_summary_status "Overall Status:" FAIL
else
    say "System update complete (${TOOLKIT_VERSION:-unknown})."
    cc_summary_status "Overall Status:" PASS
fi

if [ -f /var/run/reboot-required ]; then
    echo "reboot required"
else
    echo "No reboot needed"
fi

[ "$FAILED" -eq 0 ]
