#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : helpme-refresh
# Version     : 1.2.2-alpha1
# Category    : Documentation
# Requires    : bash python3
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Refresh installed helpme output for the current command architecture.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"

APPLY=0
TARGET="$HOME/.bash_functions"

usage() {
    cat <<'EOF_HELP'
Usage:
  cc helpme-refresh [--apply]

Refreshes the installed helpme function in ~/.bash_functions so it includes
current Captain Cronos command-framework help topics.

Default is dry-run.
EOF_HELP
}

case "${1:---dry-run}" in
    --help|-h)
        usage
        exit 0
        ;;
    --version)
        echo "1.2.2-alpha1"
        exit 0
        ;;
    --dry-run)
        APPLY=0
        ;;
    --apply)
        APPLY=1
        ;;
    *)
        usage
        exit 1
        ;;
esac

if [ ! -f "$TARGET" ]; then
    cc_error "Missing installed functions file: $TARGET"
    exit 1
fi

if [ "$APPLY" -eq 0 ]; then
    cc_log "DRY RUN: would add/refresh helpme cc topic in $TARGET"
    cc_log "After apply, run: source ~/.bash_functions"
    exit 0
fi

BACKUP="$TARGET.pre-helpme-refresh.$(date +%Y%m%d-%H%M%S).bak"
cp -a "$TARGET" "$BACKUP"

python3 - "$TARGET" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text()

cc_overview = r'''
    _cc_help_cc_overview() {
        _cc_help_version
        echo "Captain Cronos Command Framework"
        echo "================================"
        echo
        echo "Usage:"
        echo "  cc <command> [options]"
        echo
        echo "Purpose:"
        echo "  cc is the main Captain Cronos command dispatcher. It loads commands from"
        echo "  tools/commands/ and provides a single front-end for toolkit operations."
        echo
        echo "Common workflows:"
        printf "%-30s %s\n" "cc version" "Show toolkit version information."
        printf "%-30s %s\n" "cc selftest" "Run the engineering self-test suite."
        printf "%-30s %s\n" "cc framework verify" "Run framework quality gates."
        printf "%-30s %s\n" "cc doctor" "Run repository, installation, and host health checks."
        printf "%-30s %s\n" "cc update" "Run managed toolkit and system maintenance workflow."
        printf "%-30s %s\n" "cc release check" "Run pre-release verification checks."
        echo
        echo "Command families:"
        printf "%-30s %s\n" "helpme engineering" "Validation, release, and framework commands."
        printf "%-30s %s\n" "helpme storage" "Drive, SMART, report, and asset commands."
        printf "%-30s %s\n" "helpme maintenance" "Update, health, and cleanup commands."
        printf "%-30s %s\n" "helpme docs" "Documentation commands and files."
        echo
        echo "Discovery:"
        printf "%-30s %s\n" "cc" "Show dispatcher command list."
        printf "%-30s %s\n" "cc <command> --help" "Show help for one command."
        printf "%-30s %s\n" "helpme search <term>" "Search aliases, functions, and command families."
    }
'''

search_static = r'''
    _cc_help_search_static() {
        {
            echo "cc Captain Cronos Command Framework"
            echo "cc framework Command dispatcher and framework overview"
            echo "cc framework verify Run framework quality gates"
            _cc_help_cc_overview
            _cc_help_engineering
            _cc_help_docs
        } | awk -v q="$term" 'BEGIN{IGNORECASE=1} $0 ~ q {print}'
    }
'''

if "_cc_help_cc_overview()" not in text:
    marker = "    _cc_help_engineering() {"
    if marker not in text:
        raise SystemExit("Could not find helpme helper insertion point")
    text = text.replace(marker, cc_overview + "\n" + marker, 1)

if "_cc_help_search_static()" not in text:
    marker = "    case \"${1:-}\" in"
    if marker not in text:
        raise SystemExit("Could not find helpme case start")
    text = text.replace(marker, search_static + "\n" + marker, 1)

case_marker = '        version|--version)\n'
case_block = '        cc|command|commands|framework)\n            _cc_help_cc_overview\n            ;;\n'
if case_block not in text:
    if case_marker not in text:
        raise SystemExit("Could not find helpme case insertion point")
    text = text.replace(case_marker, case_block + case_marker, 1)

bad = '        name="${name#cc-}"\n        cc_bin='
good = '        name="${name#cc-}"\n        [ -n "$name" ] || return 1\n        cc_bin='
if bad in text and good not in text:
    text = text.replace(bad, good, 1)

old_modern_search = '''        {
            _cc_help_core
            _cc_help_repository
            _cc_help_storage
            _cc_help_maintenance
            _cc_help_docs
            _cc_help_engineering
        } | awk -v q="$term" 'BEGIN{IGNORECASE=1} $0 ~ q {print}'
'''
new_modern_search = '''        {
            echo "cc Captain Cronos Command Framework"
            echo "cc framework Command dispatcher and framework overview"
            echo "cc framework verify Run framework quality gates"
            _cc_help_cc_overview
            _cc_help_core
            _cc_help_repository
            _cc_help_storage
            _cc_help_maintenance
            _cc_help_docs
            _cc_help_engineering
        } | awk -v q="$term" 'BEGIN{IGNORECASE=1} $0 ~ q {print}'
'''
if old_modern_search in text:
    text = text.replace(old_modern_search, new_modern_search, 1)

old_legacy_search = '''                _cc_help_engineering | awk 'NF { print "engineering\t" $1 "\t" substr($0, index($0,$2)) }'
'''
new_legacy_search = '''                _cc_help_engineering | awk 'NF { print "engineering\t" $1 "\t" substr($0, index($0,$2)) }'
                _cc_help_search_static | awk 'NF { print "command\t" $1 "\t" substr($0, index($0,$2)) }'
'''
if old_legacy_search in text and new_legacy_search not in text:
    text = text.replace(old_legacy_search, new_legacy_search, 1)

path.write_text(text)
PY

cc_log "Refreshed helpme cc topic in $TARGET"
cc_log "Backup: $BACKUP"
cc_log "Reload with: source ~/.bash_functions"
