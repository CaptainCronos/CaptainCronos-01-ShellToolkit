#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : kernel
# Version     : 1.0.0-alpha1
# Category    : Maintenance
# Requires    : bash uname find sort awk
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Inspect and safely manage installed kernels.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-deps.sh"
source "$PROJECT_ROOT/lib/cc-kernel.sh"

usage() {
    cat <<'EOF_HELP'
Usage:
  cc kernel [help]
  cc kernel status
  cc kernel list
  cc kernel running
  cc kernel artifacts
  cc kernel health
  cc kernel cleanup [--dry-run|--apply]
  cc kernel deps

Actions:
  status   Show kernel state plus distinct /boot, backing filesystem, and EFI usage.
  list     List installed kernels with RUNNING, PROTECTED, and CANDIDATE states.
  running  Show the running release and matching installed packages.
  artifacts  Correlate packages with kernel, initramfs, map, and config artifacts.
  health   Evaluate kernel/package/artifact consistency without changing the host.
  cleanup  Review obsolete kernel packages; defaults to --dry-run.
  deps     Show required and optional kernel-management capabilities.

Safety:
  Cleanup always protects the running kernel and KEEP_COUNT newest additional
  kernels (default: 2). Package removal requires an explicit --apply.

Compatibility:
  cc kernel-cleanup [--dry-run|--apply] remains available.

Examples:
  cc kernel status
  cc kernel artifacts
  cc kernel health
  KEEP_COUNT=3 cc kernel list
  cc kernel cleanup --dry-run
EOF_HELP
}

kernel_keep_count() {
    local count="${KEEP_COUNT:-2}"
    _cc_kernel_validate_keep_count "$count" || {
        cc_error "KEEP_COUNT must be a non-negative integer: $count"
        return 2
    }
    printf '%s\n' "$count"
}

kernel_require_linux() {
    _cc_kernel_supported && return 0
    cc_error "Kernel inspection beyond the running release is unsupported on $(_cc_kernel_os)."
    return 3
}

kernel_status() {
    local running newest reboot_state keep_count platform_support running_newest=unknown
    local boot_dir boot_source boot_mount boot_use boot_bytes boot_human
    local efi_path efi_source efi_type efi_size efi_used efi_avail efi_use
    local -a kernels=() protected=() candidates=()
    running="$(_cc_kernel_running 2>/dev/null || printf unknown)"
    keep_count="$(kernel_keep_count)" || return
    mapfile -t kernels < <(_cc_kernel_list)
    newest="$(_cc_kernel_newest 2>/dev/null || true)"
    mapfile -t protected < <(_cc_kernel_protected "$keep_count" 2>/dev/null || true)
    if _cc_kernel_supported; then
        mapfile -t candidates < <(_cc_kernel_cleanup_candidates "$keep_count" 2>/dev/null || true)
    fi
    [ -z "$newest" ] && newest=unknown
    if [ "$running" != unknown ] && [ "$newest" != unknown ]; then
        if [ "$running" = "$newest" ]; then running_newest=yes; else running_newest=no; fi
    fi
    reboot_state="$(_cc_kernel_reboot_state)"
    boot_dir="$(_cc_kernel_boot_dir)"
    boot_source="$(_cc_kernel_boot_filesystem_field SOURCE 2>/dev/null || printf unknown)"
    boot_mount="$(_cc_kernel_boot_filesystem_field TARGET 2>/dev/null || printf unknown)"
    boot_use="$(_cc_kernel_boot_filesystem_field USE% 2>/dev/null || printf unknown)"
    boot_bytes="$(_cc_kernel_boot_usage_bytes 2>/dev/null || true)"
    if [ -n "$boot_bytes" ]; then boot_human="$(_cc_kernel_human_bytes "$boot_bytes")"; else boot_human=unavailable; fi
    efi_path="$(_cc_kernel_efi_path 2>/dev/null || true)"
    if _cc_kernel_supported; then
        platform_support="Linux inspection"
        _cc_kernel_cleanup_supported && platform_support+="; cleanup supported"
    else
        platform_support="$(_cc_kernel_os); running-release inspection only"
    fi

    cc_banner
    echo
    echo "Kernel Status"
    echo "-------------"
    printf '%-24s %s\n' "Platform support:" "$platform_support"
    printf '%-24s %s\n' "Running kernel:" "$running"
    printf '%-24s %s\n' "Newest installed:" "$newest"
    printf '%-24s %s\n' "Installed count:" "${#kernels[@]}"
    printf '%-24s %s\n' "Running is newest:" "$running_newest"
    printf '%-24s %s\n' "Protected count:" "${#protected[@]}"
    printf '%-24s %s\n' "Cleanup candidates:" "${#candidates[@]}"
    printf '%-24s %s\n' "Reboot state:" "$reboot_state"
    printf '%-24s %s\n' "Boot path:" "$boot_dir"
    printf '%-24s %s\n' "Boot filesystem:" "$boot_source"
    printf '%-24s %s\n' "Boot filesystem mount:" "$boot_mount"
    printf '%-24s %s\n' "Boot filesystem usage:" "$boot_use"
    printf '%-24s %s\n' "/boot artifacts:" "$boot_human"
    if [ -n "$efi_path" ]; then
        efi_source="$(_cc_kernel_efi_filesystem_field SOURCE 2>/dev/null || printf unknown)"
        efi_type="$(_cc_kernel_efi_filesystem_field FSTYPE 2>/dev/null || printf unknown)"
        efi_size="$(_cc_kernel_efi_filesystem_field SIZE 2>/dev/null || printf unknown)"
        efi_used="$(_cc_kernel_efi_filesystem_field USED 2>/dev/null || printf unknown)"
        efi_avail="$(_cc_kernel_efi_filesystem_field AVAIL 2>/dev/null || printf unknown)"
        efi_use="$(_cc_kernel_efi_filesystem_field USE% 2>/dev/null || printf unknown)"
        printf '%-24s %s mounted at %s\n' "EFI filesystem:" "$efi_source" "$efi_path"
        printf '%-24s %s\n' "EFI filesystem type:" "$efi_type"
        printf '%-24s %s (%s used, %s available)\n' "EFI size:" "$efi_size" "$efi_used" "$efi_avail"
        printf '%-24s %s\n' "EFI usage:" "$efi_use"
    else
        printf '%-24s %s\n' "EFI filesystem:" "not mounted at a known path"
    fi
    printf '%-24s %s\n' "Bootloader environment:" "$(_cc_kernel_bootloader_environment)"
}

kernel_list() {
    local keep_count kernel state
    local -a kernels=()
    keep_count="$(kernel_keep_count)" || return
    mapfile -t kernels < <(_cc_kernel_list)

    cc_banner
    echo
    echo "Installed Kernels"
    echo "-----------------"
    printf '%-36s %s\n' "Release" "State"
    printf '%-36s %s\n' "-------" "-----"
    for kernel in "${kernels[@]}"; do
        state="$(_cc_kernel_classification "$kernel" "$keep_count")"
        [ "$state" = UNCLASSIFIED ] && state=INSTALLED
        printf '%-36s %s\n' "$kernel" "$state"
    done
}

kernel_artifacts() {
    local keep_count release kernel initramfs system_map config package ownership state classification bytes size
    kernel_require_linux || return
    keep_count="$(kernel_keep_count)" || return
    cc_banner
    echo
    echo "Kernel Boot Artifacts"
    echo "---------------------"
    printf '%-28s %-6s %-9s %-10s %-6s %-9s %-10s %-10s %-24s %s\n' \
        "Release" "Kernel" "Initramfs" "System.map" "Config" "Package" "Ownership" "Health" "Classification" "Size"
    printf '%-28s %-6s %-9s %-10s %-6s %-9s %-10s %-10s %-24s %s\n' \
        "-------" "------" "---------" "----------" "------" "-------" "---------" "------" "--------------" "----"
    while IFS= read -r release; do
        [ -n "$release" ] || continue
        kernel="$(_cc_kernel_artifact_presence kernel "$release")"
        initramfs="$(_cc_kernel_artifact_presence initramfs "$release")"
        system_map="$(_cc_kernel_artifact_presence system-map "$release")"
        config="$(_cc_kernel_artifact_presence config "$release")"
        package="$(_cc_kernel_package_state "$release")"
        ownership="$(_cc_kernel_artifact_ownership "$release")"
        state="$(_cc_kernel_artifact_state "$release")"
        classification="$(_cc_kernel_classification "$release" "$keep_count")"
        bytes="$(_cc_kernel_artifact_size_bytes "$release" 2>/dev/null || true)"
        if [ -n "$bytes" ]; then size="$(_cc_kernel_human_bytes "$bytes")"; else size=unavailable; fi
        printf '%-28s %-6s %-9s %-10s %-6s %-9s %-10s %-10s %-24s %s\n' \
            "$release" "$kernel" "$initramfs" "$system_map" "$config" "$package" "$ownership" "$state" "$classification" "$size"
    done < <(_cc_kernel_artifact_releases)
    echo
    echo "States: MATCHED, MISSING, UNMATCHED, PARTIAL, UNKNOWN"
    echo "UNMATCHED does not mean safe to delete. No artifact is modified."
}

kernel_health() {
    local keep_count severity finding message
    keep_count="$(kernel_keep_count)" || return
    severity="$(_cc_kernel_health_severity "$keep_count")"
    cc_banner
    echo
    echo "Kernel Boot Health"
    echo "------------------"
    printf '%-18s %s\n' "Overall:" "$severity"
    printf '%-18s %s\n' "Boot path:" "$(_cc_kernel_boot_dir)"
    printf '%-18s %s\n' "Bootloader:" "$(_cc_kernel_bootloader_environment)"
    echo
    while IFS=$'\t' read -r finding message; do
        [ -n "$finding" ] || continue
        printf '%-6s %s\n' "$finding" "$message"
    done < <(_cc_kernel_health_findings "$keep_count")
    [ "$severity" != FAIL ]
}

kernel_running() {
    local running package
    local -a packages=()
    running="$(_cc_kernel_running)" || {
        cc_error "Unable to determine the running kernel."
        return 1
    }
    mapfile -t packages < <(_cc_kernel_companion_packages_for_version "$running" 2>/dev/null || true)

    cc_banner
    echo
    echo "Running Kernel"
    echo "--------------"
    printf '%-18s %s\n' "Release:" "$running"
    printf '%-18s %s\n' "OS:" "$(_cc_kernel_os)"
    if [ "${#packages[@]}" -eq 0 ]; then
        printf '%-18s %s\n' "Packages:" "not determinable"
    else
        printf '%-18s %s\n' "Packages:" "${packages[0]}"
        for package in "${packages[@]:1}"; do
            printf '%-18s %s\n' "" "$package"
        done
    fi
}

kernel_cleanup_log() {
    if [ "${KERNEL_APPLY:-0}" -eq 1 ]; then
        printf '%s\n' "$*" | tee -a "$KERNEL_LOG"
    else
        printf '%s\n' "$*"
    fi
}

kernel_cleanup_runner() {
    "$@" 2>&1 | tee -a "$KERNEL_LOG"
    return "${PIPESTATUS[0]}"
}

kernel_cleanup() {
    local option="${1:---dry-run}" keep_count running newest version
    local -a kernels=() protected=() candidates=() packages=() mapped=() skipped=()
    case "$option" in
        --help|-h) usage; return 0 ;;
        --dry-run) KERNEL_APPLY=0 ;;
        --apply) KERNEL_APPLY=1 ;;
        *) cc_error "Unknown kernel cleanup option: $option"; usage; return 2 ;;
    esac
    [ "$#" -le 1 ] || { cc_error "Kernel cleanup accepts one option."; usage; return 2; }
    kernel_require_linux || return
    _cc_kernel_cleanup_supported || {
        cc_error "Kernel cleanup is not supported by package manager: $(_cc_pkg_family 2>/dev/null || printf unknown)"
        return 3
    }
    keep_count="$(kernel_keep_count)" || return
    running="$(_cc_kernel_running)" || return 1
    mapfile -t kernels < <(_cc_kernel_list)
    newest="$(_cc_kernel_newest 2>/dev/null || true)"
    mapfile -t protected < <(_cc_kernel_protected "$keep_count")
    mapfile -t candidates < <(_cc_kernel_cleanup_candidates "$keep_count")

    # Complete and validate the immutable package plan before any operation.
    for version in "${candidates[@]}"; do
        if [ "$version" = "$running" ]; then
            cc_error "Safety invariant violation: running kernel entered candidate plan."
            return 5
        fi
        mapped=()
        mapfile -t mapped < <(_cc_kernel_packages_for_version "$version" 2>/dev/null || true)
        if [ "${#mapped[@]}" -eq 0 ]; then
            skipped+=("$version")
        else
            packages+=("${mapped[@]}")
        fi
    done
    if [ "${#packages[@]}" -gt 0 ]; then
        mapfile -t packages < <(printf '%s\n' "${packages[@]}" | sort -u)
    fi

    KERNEL_LOG="${LOG:-$HOME/kernel-cleanup.log}"
    if [ "$KERNEL_APPLY" -eq 1 ]; then
        : >> "$KERNEL_LOG"
    fi
    kernel_cleanup_log "Kernel cleanup review"
    kernel_cleanup_log "Running kernel: $running"
    kernel_cleanup_log "Newest installed kernel: ${newest:-unknown}"
    kernel_cleanup_log "Keep newest additional kernels: $keep_count"
    kernel_cleanup_log "Mode: $([ "$KERNEL_APPLY" -eq 1 ] && printf APPLY || printf 'DRY RUN')"
    kernel_cleanup_log "Installed kernels: ${#kernels[@]}"
    kernel_cleanup_log "Protected kernels: ${#protected[@]}"
    kernel_cleanup_log "Cleanup candidates: ${#candidates[@]}"

    if [ "${#candidates[@]}" -eq 0 ]; then
        kernel_cleanup_log "No obsolete kernels selected for purge."
        return 0
    fi
    printf 'Candidate kernels:\n'
    printf '  %s\n' "${candidates[@]}"
    if [ "${#skipped[@]}" -gt 0 ]; then
        printf 'Retained: package ownership was missing or ambiguous:\n'
        printf '  %s\n' "${skipped[@]}"
    fi
    if [ "${#packages[@]}" -eq 0 ]; then
        kernel_cleanup_log "No confidently owned kernel packages were selected."
        return 0
    fi
    printf 'Candidate purge packages:\n'
    printf '  %s\n' "${packages[@]}"

    if [ "$KERNEL_APPLY" -eq 0 ]; then
        kernel_cleanup_log "DRY RUN only. To purge candidates, run: cc kernel cleanup --apply"
        return 0
    fi

    kernel_cleanup_log "Purging obsolete kernel packages..."
    CC_PKG_RUNNER=kernel_cleanup_runner _cc_pkg_purge "${packages[@]}"
    CC_PKG_RUNNER=kernel_cleanup_runner _cc_pkg_autoremove
    CC_PKG_RUNNER=kernel_cleanup_runner _cc_pkg_clean
    kernel_cleanup_log "Bootloader refresh: $(_cc_kernel_refresh_bootloader)"
    kernel_cleanup_log "Kernel cleanup complete."
}

case "${1:-help}" in
    --help|-h|help|"") usage ;;
    --version) cc_version ;;
    status) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_status ;;
    list) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_list ;;
    running) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_running ;;
    artifacts) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_artifacts ;;
    health) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_health ;;
    cleanup) shift; kernel_cleanup "$@" ;;
    deps|dependencies) shift; bash "$PROJECT_ROOT/tools/cc" deps kernel "$@" ;;
    *) cc_error "Unknown kernel action: $1"; echo; usage; exit 1 ;;
esac
