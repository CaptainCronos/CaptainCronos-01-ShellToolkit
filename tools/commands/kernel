#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : kernel
# Version     : reads VERSION
# Category    : Maintenance
# Requires    : bash uname find sort awk
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Inspect and safely manage installed kernels.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-deps.sh"
source "$PROJECT_ROOT/lib/cc-kernel.sh"
source "$PROJECT_ROOT/lib/cc-environment.sh"

usage() {
    cat <<'EOF_HELP'
Usage:
  cc kernel [help]
  cc kernel status
  cc kernel list
  cc kernel running
  cc kernel platform
  cc kernel artifacts
  cc kernel health
  cc kernel cleanup [--dry-run|--apply]
  cc kernel deps

Actions:
  status   Show kernel state plus distinct /boot, backing filesystem, and EFI usage.
  list     List installed sets with role, protection, APT-mark, and mapping states.
  running  Show the running release and matching installed packages.
  platform  Show detected kernel environment and Captain Cronos support.
  artifacts  Correlate packages with kernel, initramfs, map, and config artifacts.
  health   Evaluate kernel/package/artifact consistency without changing the host.
  cleanup  Review obsolete kernel packages; defaults to --dry-run.
  deps     Show required and optional kernel-management capabilities.

Safety:
  Cleanup protects the running kernel, a verified nearest-older fallback, a
  verified newest pending kernel, and KEEP_COUNT newest additional installed
  sets (default: 2). Only verified package/artifact mappings are candidates.
  Package removal requires an explicit --apply.

Compatibility:
  cc kernel-cleanup [--dry-run|--apply] remains available.

Examples:
  cc kernel status
  cc kernel platform
  cc kernel artifacts
  cc kernel health
  KEEP_COUNT=3 cc kernel list
  cc kernel cleanup --dry-run
EOF_HELP
}

kernel_keep_count() {
    local count="${KEEP_COUNT:-2}"
    _cc_kernel_validate_keep_count "$count" || {
        cc_error "KEEP_COUNT must be a non-negative integer: $count"
        return 2
    }
    printf '%s\n' "$count"
}

kernel_require_linux() {
    _cc_kernel_supported && return 0
    cc_error "Kernel inspection beyond the running release is unsupported on $(_cc_kernel_os)."
    return 3
}

kernel_prepare_inventory() {
    _cc_kernel_can_correlate_packages || return 0
    _cc_kernel_inventory_capture || {
        cc_error "Installed package database query failed; refusing kernel package correlation."
        return 5
    }
}

kernel_status() {
    local keep_count running severity image_state modules_state headers_state artifact_status
    local newer reboot boot_usage boot_usage_status=INFO cleanup_detail efi_path
    keep_count="$(kernel_keep_count)" || return
    kernel_prepare_inventory || return
    _cc_kernel_snapshot_capture "$keep_count"
    running="$(_cc_kernel_snapshot_get running)"
    severity="$(_cc_kernel_snapshot_get health_status)"
    image_state="$(_cc_kernel_component_state "$running" image 2>/dev/null || printf unavailable)"
    modules_state="$(_cc_kernel_component_state "$running" modules 2>/dev/null || printf unavailable)"
    headers_state="$(_cc_kernel_component_state "$running" headers 2>/dev/null || printf unavailable)"
    newer="$(_cc_kernel_snapshot_get pending)"
    reboot="$(_cc_kernel_snapshot_get reboot_state)"
    boot_usage="$(_cc_kernel_snapshot_get boot_filesystem_usage)"
    if [[ "${boot_usage%%%}" =~ ^[0-9]+$ ]] && [ "${boot_usage%%%}" -ge "${CC_KERNEL_USAGE_WARN_PERCENT:-90}" ]; then
        boot_usage_status=WARN
    elif [ "$boot_usage" != unknown ] && [ "$boot_usage" != 'not applicable' ]; then
        boot_usage_status=PASS
    fi
    if [ "$(_cc_kernel_snapshot_get artifact_missing)" = 0 ] &&
        [ "$(_cc_kernel_snapshot_get artifact_partial)" = 0 ] &&
        [ "$(_cc_kernel_snapshot_get artifact_unmatched)" = 0 ] &&
        [ "$(_cc_kernel_snapshot_get artifact_unknown)" = 0 ]; then artifact_status=PASS
    else artifact_status=WARN
    fi
    cleanup_detail="$(_cc_kernel_snapshot_get cleanup_candidate_count) eligible set(s)"

    echo "Captain Cronos Kernel Status"
    echo "============================"
    echo
    kernel_status_detail "Running kernel:" INFO "$running"
    kernel_status_detail "Running image package:" "$([ "$image_state" = present ] && printf PASS || printf FAIL)" "$image_state"
    kernel_status_detail "Running modules:" "$([ "$modules_state" = present ] && printf PASS || printf INFO)" "$modules_state"
    kernel_status_detail "Running headers:" "$([ "$headers_state" = present ] && printf PASS || printf INFO)" "$headers_state"
    kernel_status_detail "Installed kernel sets:" INFO "$(_cc_kernel_snapshot_get installed_count)"
    kernel_status_detail "Older kernel sets:" INFO "$(_cc_kernel_snapshot_get older_count)"
    kernel_status_detail "Cleanup candidates:" INFO "$cleanup_detail"
    kernel_status_detail "Kernel artifacts:" "$artifact_status" "matched $(_cc_kernel_snapshot_get artifact_matched)"
    kernel_status_detail "Newer installed kernel:" INFO "$newer"
    if [ "$reboot" = required ] || [ "$reboot" = newer-kernel-installed ]; then
        kernel_status_detail "Reboot recommended:" INFO yes
    else
    kernel_status_detail "Reboot recommended:" INFO no
    fi
    kernel_status_detail "Boot path:" INFO "$(_cc_kernel_snapshot_get boot_path)"
    kernel_status_detail "Boot filesystem:" INFO "$(_cc_kernel_snapshot_get boot_filesystem)"
    kernel_status_detail "Boot filesystem mount:" INFO "$(_cc_kernel_snapshot_get boot_filesystem_mount)"
    kernel_status_detail "/boot filesystem usage:" "$boot_usage_status" "$boot_usage"
    kernel_status_detail "/boot artifacts:" INFO "$(_cc_kernel_snapshot_get boot_artifact_usage)"
    efi_path="$(_cc_kernel_efi_path 2>/dev/null || true)"
    if [ -n "$efi_path" ]; then
        kernel_status_detail "EFI filesystem:" INFO "$(_cc_kernel_efi_filesystem_field SOURCE 2>/dev/null || printf unknown) mounted at $efi_path"
        kernel_status_detail "EFI filesystem type:" INFO "$(_cc_kernel_efi_filesystem_field FSTYPE 2>/dev/null || printf unknown)"
        kernel_status_detail "EFI size:" INFO "$(_cc_kernel_efi_filesystem_field SIZE 2>/dev/null || printf unknown) ($(_cc_kernel_efi_filesystem_field USED 2>/dev/null || printf unknown) used, $(_cc_kernel_efi_filesystem_field AVAIL 2>/dev/null || printf unknown) available)"
        kernel_status_detail "EFI usage:" INFO "$(_cc_kernel_snapshot_get efi_usage)"
    else
        kernel_status_detail "EFI filesystem:" INFO "not mounted at a known path"
    fi
    kernel_status_detail "Bootloader environment:" INFO "$(_cc_kernel_snapshot_get bootloader)"
    echo
    cc_summary_status "Overall Status:" "$severity"
    [ "$severity" != FAIL ]
}

kernel_status_detail() {
    local label="$1" status="$2" detail="$3"
    cc_dotted_leader_fd 1 "$label" 40
    cc_status_cell "$status" 6
    printf ' %s\n' "$detail"
}

kernel_platform() {
    local cleanup_adapter=none
    _cc_kernel_can_cleanup && cleanup_adapter="$(_cc_kernel_package_adapter)"
    cc_banner
    echo
    echo "Kernel Platform"
    echo "---------------"
    printf '%-28s %s\n' "Operating platform:" "$(_cc_kernel_os)"
    printf '%-28s %s\n' "Distribution family:" "$(_cc_kernel_distribution_family)"
    printf '%-28s %s\n' "Kernel package model:" "$(_cc_kernel_package_model)"
    printf '%-28s %s\n' "Image package model:" "$(_cc_kernel_image_package_pattern)"
    printf '%-28s %s\n' "Package adapter:" "$(_cc_kernel_package_adapter)"
    echo
    printf '%-28s %s\n' "Initramfs provider:" "$(_cc_kernel_initramfs_provider)"
    printf '%-28s %s\n' "Additional providers:" "$(_cc_kernel_initramfs_additional_providers)"
    printf '%-28s %s\n' "Initramfs interface:" "$(_cc_kernel_initramfs_interface)"
    printf '%-28s %s\n' "Initramfs status:" "$(_cc_kernel_initramfs_status)"
    echo
    printf '%-28s %s\n' "Bootloader environment:" "$(_cc_kernel_bootloader_environment)"
    printf '%-28s %s\n' "EFI filesystem:" "$(_cc_kernel_efi_filesystem_state)"
    printf '%-28s %s\n' "EFI runtime:" "$(_cc_kernel_efi_runtime_state)"
    echo
    printf '%-28s %s\n' "Kernel inspection:" "$(_cc_kernel_support_word _cc_kernel_can_inspect)"
    printf '%-28s %s\n' "Artifact inspection:" "$(_cc_kernel_support_word _cc_kernel_can_inspect_artifacts)"
    printf '%-28s %s\n' "Package correlation:" "$(_cc_kernel_support_word _cc_kernel_can_correlate_packages)"
    printf '%-28s %s\n' "Cleanup:" "$(_cc_kernel_support_word _cc_kernel_can_cleanup)"
    printf '%-28s %s\n' "Cleanup adapter:" "$cleanup_adapter"
    printf '%-28s %s\n' "Kernel installation:" "not implemented"
    printf '%-28s %s\n' "Initramfs mutation:" "not implemented"
    printf '%-28s %s\n' "Bootloader mutation:" "not implemented"
}

kernel_deps() {
    local provider interface score
    bash "$PROJECT_ROOT/tools/cc" deps kernel
    echo
    echo "Detected initramfs providers"
    echo "----------------------------"
    if _cc_kernel_supported; then
        for provider in initramfs-tools dracut mkinitcpio; do
            interface="$(_cc_kernel_provider_interface_name "$provider")"
            score="$(_cc_kernel_provider_score "$provider")"
            if [ "$score" -gt 0 ]; then
                printf '%-20s %-14s %s\n' "$interface" detected "evidence score: $score"
            else
                printf '%-20s %-14s\n' "$interface" "not detected"
            fi
        done
        printf '%-20s %s\n' "Primary provider" "$(_cc_kernel_initramfs_provider)"
    else
        printf '%-20s %s\n' "Provider inspection" "not applicable"
    fi
    printf '%-20s %s\n' "Package database" "$(_cc_pkg_database_available && printf available || printf unavailable)"
    printf '%-20s %s\n' "Mutation support" "not implemented"
}

kernel_list() {
    local keep_count kernel state mark mapping
    local -a kernels=()
    keep_count="$(kernel_keep_count)" || return
    kernel_prepare_inventory || return
    mapfile -t kernels < <(_cc_kernel_list)

    cc_banner
    echo
    echo "Installed Kernels"
    echo "-----------------"
    printf '%-32s %-28s %-10s %s\n' "Release" "Protection" "APT mark" "Mapping"
    printf '%-32s %-28s %-10s %s\n' "-------" "----------" "--------" "-------"
    for kernel in "${kernels[@]}"; do
        state="$(_cc_kernel_classification "$kernel" "$keep_count")"
        [ "$state" = UNCLASSIFIED ] && state=INSTALLED
        mark="$(_cc_kernel_set_mark_state "$kernel")"
        mapping="$(_cc_kernel_set_mapping_state "$kernel")"
        printf '%-32s %-28s %-10s %s\n' "$kernel" "$state" "$mark" "$mapping"
    done
}

kernel_artifacts() {
    local keep_count release kernel initramfs system_map config package ownership state classification bytes size
    kernel_require_linux || return
    keep_count="$(kernel_keep_count)" || return
    kernel_prepare_inventory || return
    cc_banner
    echo
    echo "Kernel Boot Artifacts"
    echo "---------------------"
    printf '%-28s %-6s %-9s %-10s %-6s %-9s %-10s %-10s %-24s %s\n' \
        "Release" "Kernel" "Initramfs" "System.map" "Config" "Package" "Ownership" "Health" "Classification" "Size"
    printf '%-28s %-6s %-9s %-10s %-6s %-9s %-10s %-10s %-24s %s\n' \
        "-------" "------" "---------" "----------" "------" "-------" "---------" "------" "--------------" "----"
    while IFS= read -r release; do
        [ -n "$release" ] || continue
        kernel="$(_cc_kernel_artifact_presence kernel "$release")"
        initramfs="$(_cc_kernel_artifact_presence initramfs "$release")"
        system_map="$(_cc_kernel_artifact_presence system-map "$release")"
        config="$(_cc_kernel_artifact_presence config "$release")"
        package="$(_cc_kernel_package_state "$release")"
        ownership="$(_cc_kernel_artifact_ownership "$release")"
        state="$(_cc_kernel_artifact_state "$release")"
        classification="$(_cc_kernel_classification "$release" "$keep_count")"
        bytes="$(_cc_kernel_artifact_size_bytes "$release" 2>/dev/null || true)"
        if [ -n "$bytes" ]; then size="$(_cc_kernel_human_bytes "$bytes")"; else size=unavailable; fi
        printf '%-28s %-6s %-9s %-10s %-6s %-9s %-10s %-10s %-24s %s\n' \
            "$release" "$kernel" "$initramfs" "$system_map" "$config" "$package" "$ownership" "$state" "$classification" "$size"
    done < <(_cc_kernel_artifact_releases)
    echo
    echo "States: MATCHED, MISSING, UNMATCHED, PARTIAL, UNKNOWN"
    echo "UNMATCHED does not mean safe to delete. No artifact is modified."
}

kernel_health() {
    local keep_count severity finding code message
    keep_count="$(kernel_keep_count)" || return
    kernel_prepare_inventory || return
    _cc_kernel_snapshot_capture "$keep_count"
    severity="$(_cc_kernel_snapshot_get health_status)"
    cc_banner
    echo
    echo "Kernel Boot Health"
    echo "------------------"
    printf '%-18s ' "Overall:"
    cc_status_word "$severity"
    printf '\n'
    printf '%-18s %s\n' "Boot path:" "$(_cc_kernel_boot_dir)"
    printf '%-18s %s\n' "Bootloader:" "$(_cc_kernel_bootloader_environment)"
    echo
    while IFS=$'\t' read -r finding code message; do
        [ -n "$finding" ] || continue
        cc_status_cell "$finding" 6
        printf ' %-34s %s\n' "$code" "$message"
    done < <(_cc_kernel_snapshot_findings)
    [ "$severity" != FAIL ]
}

kernel_running() {
    local running package
    local -a packages=()
    kernel_prepare_inventory || return
    running="$(_cc_kernel_running)" || {
        cc_error "Unable to determine the running kernel."
        return 1
    }
    mapfile -t packages < <(_cc_kernel_companion_packages_for_version "$running" 2>/dev/null || true)

    cc_banner
    echo
    echo "Running Kernel"
    echo "--------------"
    printf '%-18s %s\n' "Release:" "$running"
    printf '%-18s %s\n' "OS:" "$(_cc_kernel_os)"
    if [ "${#packages[@]}" -eq 0 ]; then
        printf '%-18s %s\n' "Packages:" "not determinable"
    else
        printf '%-18s %s\n' "Packages:" "${packages[0]}"
        for package in "${packages[@]:1}"; do
            printf '%-18s %s\n' "" "$package"
        done
    fi
}

kernel_cleanup_log() {
    if [ "${KERNEL_APPLY:-0}" -eq 1 ]; then
        printf '%s\n' "$*" | tee -a "$KERNEL_LOG"
    else
        printf '%s\n' "$*"
    fi
}

kernel_cleanup_runner() {
    "$@" 2>&1 | tee -a "$KERNEL_LOG"
    return "${PIPESTATUS[0]}"
}

kernel_cleanup() {
    local option="${1:---dry-run}" keep_count running newest pending fallback version kib reclaimed
    local package purge_status=0 current_running
    local -a kernels=() protected=() candidates=() packages=() removed=() remaining=()
    case "$option" in
        --help|-h) usage; return 0 ;;
        --dry-run) KERNEL_APPLY=0 ;;
        --apply) KERNEL_APPLY=1 ;;
        *) cc_error "Unknown kernel cleanup option: $option"; usage; return 2 ;;
    esac
    [ "$#" -le 1 ] || { cc_error "Kernel cleanup accepts one option."; usage; return 2; }
    kernel_require_linux || return
    _cc_kernel_cleanup_supported || {
        cc_error "Kernel cleanup is not supported by package manager: $(_cc_pkg_family 2>/dev/null || printf unknown)"
        return 3
    }
    keep_count="$(kernel_keep_count)" || return
    kernel_prepare_inventory || return
    running="$(_cc_kernel_running)" || return 1
    mapfile -t kernels < <(_cc_kernel_list)
    newest="$(_cc_kernel_newest 2>/dev/null || true)"
    pending="$(_cc_kernel_pending_release 2>/dev/null || true)"
    fallback="$(_cc_kernel_fallback_release 2>/dev/null || true)"
    mapfile -t protected < <(_cc_kernel_protected "$keep_count")
    mapfile -t candidates < <(_cc_kernel_cleanup_candidates "$keep_count")
    mapfile -t packages < <(_cc_kernel_cleanup_packages "$keep_count")
    kib="$(_cc_kernel_package_installed_kib "${packages[@]}" 2>/dev/null || true)"
    if [ -n "$kib" ]; then reclaimed="$(_cc_kernel_human_bytes "$((kib * 1024))")"; else reclaimed=unavailable; fi

    for version in "${candidates[@]}"; do
        [ "$version" != "$running" ] || {
            cc_error "Safety invariant violation: running kernel entered candidate plan."
            return 5
        }
        _cc_kernel_in_list "$version" "${protected[@]}" && {
            cc_error "Safety invariant violation: protected kernel entered candidate plan: $version"
            return 5
        }
    done

    KERNEL_LOG="${LOG:-$(cc_env_log_dir)/kernel-cleanup.log}"
    if [ "$KERNEL_APPLY" -eq 1 ]; then
        umask 077
        mkdir -p "$(dirname "$KERNEL_LOG")"
        chmod 700 "$(dirname "$KERNEL_LOG")"
        : >> "$KERNEL_LOG"
        chmod 600 "$KERNEL_LOG"
    fi
    kernel_cleanup_log "Kernel cleanup review"
    kernel_cleanup_log "Running kernel: $running"
    kernel_cleanup_log "Protected fallback: ${fallback:-none available}"
    kernel_cleanup_log "Protected pending kernel: ${pending:-none}"
    kernel_cleanup_log "Newest installed kernel: ${newest:-unknown}"
    kernel_cleanup_log "Keep newest additional kernels: $keep_count"
    kernel_cleanup_log "Mode: $([ "$KERNEL_APPLY" -eq 1 ] && printf APPLY || printf 'DRY RUN')"
    kernel_cleanup_log "Installed kernels: ${#kernels[@]}"
    kernel_cleanup_log "Protected kernels: ${#protected[@]}"
    kernel_cleanup_log "Cleanup candidates: ${#candidates[@]}"
    kernel_cleanup_log "Approximate installed size: $reclaimed"

    if [ "${#candidates[@]}" -eq 0 ]; then
        kernel_cleanup_log "No obsolete kernels selected for purge."
        return 0
    fi
    printf 'Candidate kernels:\n'
    printf '  %s\n' "${candidates[@]}"
    if [ "${#packages[@]}" -eq 0 ]; then
        cc_error "Candidate package mapping was not complete; refusing cleanup."
        return 5
    fi
    printf 'Candidate purge packages:\n'
    printf '  %s\n' "${packages[@]}"

    if [ "$KERNEL_APPLY" -eq 0 ]; then
        kernel_cleanup_log "DRY RUN only. To purge candidates, run: cc kernel cleanup --apply"
        return 0
    fi

    [ "$(_cc_kernel_set_mapping_state "$running")" = verified ] || {
        cc_error "Running-kernel package mapping is uncertain; refusing cleanup apply."
        return 5
    }
    current_running="$(_cc_kernel_running)" || return 1
    [ "$current_running" = "$running" ] || {
        cc_error "Running kernel changed after plan creation; refusing cleanup apply."
        return 5
    }
    kernel_cleanup_log "Purging obsolete kernel packages..."
    CC_PKG_RUNNER=kernel_cleanup_runner _cc_pkg_purge "${packages[@]}" || purge_status=$?
    if [ "$purge_status" -ne 0 ]; then
        for package in "${packages[@]}"; do
            if _cc_pkg_is_installed "$package"; then remaining+=("$package"); else removed+=("$package"); fi
        done
        kernel_cleanup_log "Kernel cleanup FAILED (package manager status: $purge_status)."
        if [ "${#removed[@]}" -gt 0 ]; then
            kernel_cleanup_log "Packages no longer installed:"
            printf '  %s\n' "${removed[@]}"
        fi
        if [ "${#remaining[@]}" -gt 0 ]; then
            kernel_cleanup_log "Packages still installed:"
            printf '  %s\n' "${remaining[@]}"
        fi
        return "$purge_status"
    fi
    kernel_cleanup_log "Kernel cleanup complete."
}

case "${1:-status}" in
    --help|-h|help|"") usage ;;
    --version) cc_version ;;
    status) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_status ;;
    list) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_list ;;
    running) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_running ;;
    platform|capabilities) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_platform ;;
    artifacts) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_artifacts ;;
    health) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_health ;;
    cleanup) shift; kernel_cleanup "$@" ;;
    deps|dependencies) shift; [ "$#" -eq 0 ] || { usage; exit 2; }; kernel_deps ;;
    *) cc_error "Unknown kernel action: $1"; echo; usage; exit 2 ;;
esac
