#!/usr/bin/env bash
#
# ==============================================================================
# Captain Cronos Shell Toolkit
# ------------------------------------------------------------------------------
# Script      : repos
# Version     : reads VERSION
# Category    : Repository
# Requires    : bash git awk find du
# Repository  : CaptainCronos-01-ShellToolkit
# Purpose     : Inventory and manage local Git repositories.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"
source "$PROJECT_ROOT/lib/cc-common.sh"
source "$PROJECT_ROOT/lib/cc-environment.sh"

ROOT="${CAPTAIN_CRONOS_GIT_ROOT:-$HOME/GitHub}"
ACTION="status"
APPLY=0
OUT=""
BUNDLE_DIR="${CAPTAIN_CRONOS_REPO_BUNDLE_DIR:-$(cc_env_bundle_dir)}"
MESSAGE=""
ACTION_PASSES=0
ACTION_WARNINGS=0
ACTION_FAILURES=0

usage() {
    cat <<'EOF_HELP'
Usage:
  cc repos [list|status|health|inventory|fetch|pull|sync|backup|commit|push|publish|verify|doctor] [options]

Options:
  --root PATH      Repository root. Default: ~/GitHub
  --out FILE       Output file for inventory. Supports .md and .csv
  --bundle-dir DIR Bundle output directory. Default: ~/.captaincronos/repo-bundles
  --message TEXT   Commit message for commit actions.
  --apply          Apply mutating actions. Default is dry-run.

Actions:
  list       List detected Git repositories.
  status     Show repository dashboard with health, branch, state, sync, type, and origin.
  health     Show health-only dashboard and summary.
  inventory  Generate repository inventory table. Use --out to save.
  fetch      Fetch all remotes and prune stale refs. Dry-run by default.
  pull       Pull --ff-only for clean repositories. Dry-run by default.
  sync       Fetch then pull --ff-only for clean repositories. Dry-run by default.
  backup     Create git bundle backups for clean repositories. Dry-run by default.
  commit     Commit dirty repositories with --message. Dry-run by default.
  push       Push clean repositories ahead of origin. Dry-run by default.
  publish    Push clean main branches with git push origin main. Dry-run by default.
  verify     Run cc verify for toolkit repositories that contain tools/cc.
  doctor     Run cc doctor for toolkit repositories that contain tools/cc.

Examples:
  cc repos status
  cc repos health
  cc repos inventory --out ~/repo-inventory.md
  cc repos inventory --out ~/repo-inventory.csv
  cc repos fetch --apply
  cc repos sync --apply
  cc repos backup --apply
  cc repos commit --message "work in progress"
  cc repos push --apply
  cc repos publish --apply
EOF_HELP
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --version)
            cc_version
            exit 0
            ;;
        --root)
            shift
            ROOT="${1:-}"
            [ -n "$ROOT" ] || { usage; exit 1; }
            shift
            ;;
        --out)
            shift
            OUT="${1:-}"
            [ -n "$OUT" ] || { usage; exit 1; }
            shift
            ;;
        --bundle-dir)
            shift
            BUNDLE_DIR="${1:-}"
            [ -n "$BUNDLE_DIR" ] || { usage; exit 1; }
            shift
            ;;
        --message)
            shift
            MESSAGE="${1:-}"
            [ -n "$MESSAGE" ] || { usage; exit 1; }
            shift
            ;;
        --message=*)
            MESSAGE="${1#--message=}"
            [ -n "$MESSAGE" ] || { usage; exit 1; }
            shift
            ;;
        --apply)
            APPLY=1
            shift
            ;;
        list|status|health|inventory|pull|fetch|sync|backup|commit|push|publish|verify|doctor)
            ACTION="$1"
            shift
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

case "$ACTION" in
    commit)
        if [ -z "$MESSAGE" ]; then
            cc_error "cc repos $ACTION requires --message."
            echo
            usage
            exit 2
        fi
        ;;
esac

find_repos() {
    find "$ROOT" -maxdepth 3 -type d -name .git 2>/dev/null | sed 's#/.git$##' | sort
}

repo_branch() {
    local branch
    branch="$(git -C "$1" branch --show-current 2>/dev/null || true)"
    [ -n "$branch" ] && echo "$branch" || echo detached
}

repo_origin() {
    git -C "$1" remote get-url origin 2>/dev/null || echo none
}

repo_state() {
    if [ -n "$(git -C "$1" status --short 2>/dev/null)" ]; then
        echo dirty
    else
        echo clean
    fi
}

repo_has_unmerged_paths() {
    git -C "$1" diff --name-only --diff-filter=U 2>/dev/null | grep -q .
}

repo_upstream() {
    local repo="$1" branch upstream
    upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    if [ -n "$upstream" ]; then
        echo "$upstream"
        return 0
    fi
    branch="$(repo_branch "$repo")"
    if [ "$branch" != "detached" ] && git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        echo "origin/$branch"
        return 0
    fi
    echo ""
}

repo_counts() {
    local repo="$1" upstream
    upstream="$(repo_upstream "$repo")"
    if [ -z "$upstream" ]; then
        echo "0 0 0"
        return 0
    fi
    git -C "$repo" rev-list --left-right --count HEAD..."$upstream" 2>/dev/null | awk '{print $1, $2, 1}' || echo "0 0 0"
}

repo_ahead_behind() {
    local repo="$1" counts ahead behind upstream_flag
    counts="$(repo_counts "$repo")"
    ahead="$(echo "$counts" | awk '{print $1}')"
    behind="$(echo "$counts" | awk '{print $2}')"
    upstream_flag="$(echo "$counts" | awk '{print $3}')"
    if [ "$upstream_flag" = "0" ]; then
        echo "no-upstream"
    else
        echo "ahead:$ahead behind:$behind"
    fi
}

repo_last_commit() {
    git -C "$1" log -1 --format='%cs %h %s' 2>/dev/null || echo none
}

repo_size() {
    du -sh "$1" 2>/dev/null | awk '{print $1}'
}

repo_default_remote_branch() {
    local repo="$1" default
    default="$(git -C "$repo" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's#refs/remotes/origin/##' || true)"
    if [ -n "$default" ]; then
        echo "$default"
    elif git -C "$repo" show-ref --verify --quiet refs/remotes/origin/main; then
        echo main
    elif git -C "$repo" show-ref --verify --quiet refs/remotes/origin/master; then
        echo master
    else
        echo unknown
    fi
}

repo_branch_counts() {
    local repo="$1" local_count remote_count
    local_count="$(git -C "$repo" branch --list 2>/dev/null | wc -l | tr -d ' ')"
    remote_count="$(git -C "$repo" branch -r 2>/dev/null | grep -vc 'HEAD ->' || true)"
    echo "local:$local_count remote:$remote_count"
}

repo_type() {
    local repo="$1" name
    name="$(basename "$repo")"
    if [ -f "$repo/tools/cc" ] || [[ "$name" == *ShellToolkit* ]]; then
        echo "Toolkit"
    elif [ -f "$repo/docs/developer/CC-STD-001-Script-Header.md" ] || [[ "$name" == *Standards* ]]; then
        echo "Standards"
    elif [ -f "$repo/MASTER_ROADMAP.md" ]; then
        echo "Roadmap"
    elif [ -d "$repo/docs" ]; then
        echo "Docs"
    elif [ -f "$repo/package.json" ]; then
        echo "Node"
    elif [ -f "$repo/requirements.txt" ] || [ -d "$repo/src" ]; then
        echo "Python"
    else
        echo "General"
    fi
}

repo_health() {
    local repo="$1" score=100 branch state origin counts ahead behind upstream_flag default_branch
    branch="$(repo_branch "$repo")"
    state="$(repo_state "$repo")"
    origin="$(repo_origin "$repo")"
    counts="$(repo_counts "$repo")"
    ahead="$(echo "$counts" | awk '{print $1}')"
    behind="$(echo "$counts" | awk '{print $2}')"
    upstream_flag="$(echo "$counts" | awk '{print $3}')"
    default_branch="$(repo_default_remote_branch "$repo")"

    [ "$state" = "dirty" ] && score=$((score - 25))
    [ "$branch" = "detached" ] && score=$((score - 20))
    [ "$origin" = "none" ] && score=$((score - 20))
    [ "$upstream_flag" = "0" ] && score=$((score - 15))
    [ "$ahead" -gt 0 ] 2>/dev/null && score=$((score - 10))
    [ "$behind" -gt 0 ] 2>/dev/null && score=$((score - 10))
    [ "$default_branch" = "unknown" ] && score=$((score - 5))
    git -C "$repo" diff --name-only --diff-filter=U 2>/dev/null | grep -q . && score=$((score - 40))

    [ "$score" -lt 0 ] && score=0

    if [ "$score" -ge 90 ]; then
        echo "PASS:$score"
    elif [ "$score" -ge 70 ]; then
        echo "WARN:$score"
    else
        echo "FAIL:$score"
    fi
}

csv_escape() {
    printf '%s' "$1" | sed 's/"/""/g; s/^/"/; s/$/"/'
}

print_header() {
    cc_banner
    printf '%-14s %s\n' "Repo root:" "$ROOT"
    printf '%-14s %s\n' "Action:" "$ACTION"
    printf '%-14s %s\n' "Apply:" "$APPLY"
    [ -n "$OUT" ] && printf '%-14s %s\n' "Output:" "$OUT"
    echo
}

summary_footer() {
    local total=0 clean=0 dirty=0 pass=0 warn=0 fail=0 ahead_total=0 behind_total=0 toolkit=0 standards=0 docs=0 roadmap=0 other=0
    local repo state health type counts ahead behind
    while read -r repo; do
        [ -n "$repo" ] || continue
        total=$((total + 1))
        state="$(repo_state "$repo")"
        [ "$state" = "clean" ] && clean=$((clean + 1)) || dirty=$((dirty + 1))
        health="$(repo_health "$repo")"
        case "$health" in
            PASS:*) pass=$((pass + 1)) ;;
            WARN:*) warn=$((warn + 1)) ;;
            FAIL:*) fail=$((fail + 1)) ;;
        esac
        counts="$(repo_counts "$repo")"
        ahead="$(echo "$counts" | awk '{print $1}')"
        behind="$(echo "$counts" | awk '{print $2}')"
        [ "$ahead" -gt 0 ] 2>/dev/null && ahead_total=$((ahead_total + 1))
        [ "$behind" -gt 0 ] 2>/dev/null && behind_total=$((behind_total + 1))
        type="$(repo_type "$repo")"
        case "$type" in
            Toolkit) toolkit=$((toolkit + 1)) ;;
            Standards) standards=$((standards + 1)) ;;
            Docs) docs=$((docs + 1)) ;;
            Roadmap) roadmap=$((roadmap + 1)) ;;
            *) other=$((other + 1)) ;;
        esac
    done < <(find_repos)

    echo
    echo "Summary"
    echo "-------"
    printf '%-14s %s\n' "Repositories:" "$total"
    printf '%-14s %s\n' "Clean:" "$clean"
    printf '%-14s %s\n' "Dirty:" "$dirty"
    printf '%-14s %s\n' "PASS:" "$pass"
    printf '%-14s %s\n' "WARN:" "$warn"
    printf '%-14s %s\n' "FAIL:" "$fail"
    printf '%-14s %s\n' "Ahead:" "$ahead_total"
    printf '%-14s %s\n' "Behind:" "$behind_total"
    printf '%-14s %s\n' "Toolkit:" "$toolkit"
    printf '%-14s %s\n' "Standards:" "$standards"
    printf '%-14s %s\n' "Docs:" "$docs"
    printf '%-14s %s\n' "Roadmap:" "$roadmap"
    printf '%-14s %s\n' "Other:" "$other"
}

inventory_md() {
    echo "# Repository Inventory"
    echo
    echo "Generated: $(date)"
    echo "Root: $ROOT"
    echo
    echo "| Repository | Health | Type | Branch | Default | Branches | State | Sync | Origin | Last Commit | Size |"
    echo "|---|---|---|---|---|---|---|---|---|---|---|"
    while read -r repo; do
        [ -n "$repo" ] || continue
        echo "| $(basename "$repo") | $(repo_health "$repo") | $(repo_type "$repo") | $(repo_branch "$repo") | $(repo_default_remote_branch "$repo") | $(repo_branch_counts "$repo") | $(repo_state "$repo") | $(repo_ahead_behind "$repo") | $(repo_origin "$repo") | $(repo_last_commit "$repo" | sed 's/|/-/g') | $(repo_size "$repo") |"
    done < <(find_repos)
    summary_footer
}

inventory_csv() {
    echo "repository,path,health,type,branch,default_branch,branches,state,sync,origin,last_commit,size"
    while read -r repo; do
        [ -n "$repo" ] || continue
        printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
            "$(csv_escape "$(basename "$repo")")" \
            "$(csv_escape "$repo")" \
            "$(csv_escape "$(repo_health "$repo")")" \
            "$(csv_escape "$(repo_type "$repo")")" \
            "$(csv_escape "$(repo_branch "$repo")")" \
            "$(csv_escape "$(repo_default_remote_branch "$repo")")" \
            "$(csv_escape "$(repo_branch_counts "$repo")")" \
            "$(csv_escape "$(repo_state "$repo")")" \
            "$(csv_escape "$(repo_ahead_behind "$repo")")" \
            "$(csv_escape "$(repo_origin "$repo")")" \
            "$(csv_escape "$(repo_last_commit "$repo")")" \
            "$(csv_escape "$(repo_size "$repo")")"
    done < <(find_repos)
}

write_inventory() {
    if [ -z "$OUT" ]; then
        inventory_md
        return 0
    fi
    mkdir -p "$(dirname "$OUT")"
    case "$OUT" in
        *.csv) inventory_csv > "$OUT" ;;
        *) inventory_md > "$OUT" ;;
    esac
    cc_log "Inventory written: $OUT"
}

repo_fetch() {
    local repo="$1"
    if [ "$APPLY" -eq 1 ]; then
        git -C "$repo" fetch --all --prune
    else
        echo "DRY RUN: git -C '$repo' fetch --all --prune"
    fi
}

repo_pull() {
    local repo="$1"
    if [ "$(repo_state "$repo")" != "clean" ]; then
        echo "SKIP: working tree is dirty"
        return 0
    fi
    if [ -z "$(repo_upstream "$repo")" ]; then
        echo "SKIP: no upstream configured"
        return 0
    fi
    if [ "$APPLY" -eq 1 ]; then
        git -C "$repo" pull --ff-only
    else
        echo "DRY RUN: git -C '$repo' pull --ff-only"
    fi
}

repo_backup() {
    local repo="$1" name stamp bundle
    name="$(basename "$repo")"
    stamp="$(date +%Y%m%d-%H%M%S)"
    bundle="$BUNDLE_DIR/${name}-${stamp}.bundle"
    if [ "$(repo_state "$repo")" != "clean" ]; then
        echo "SKIP: working tree is dirty"
        return 0
    fi
    if [ "$APPLY" -eq 1 ]; then
        mkdir -p "$BUNDLE_DIR"
        git -C "$repo" bundle create "$bundle" --all
        echo "WROTE: $bundle"
    else
        echo "DRY RUN: git -C '$repo' bundle create '$bundle' --all"
    fi
}

repo_action_result() {
    local repo="$1" status="$2" detail="$3"

    case "$status" in
        PASS) ACTION_PASSES=$((ACTION_PASSES + 1)) ;;
        WARN) ACTION_WARNINGS=$((ACTION_WARNINGS + 1)) ;;
        FAIL) ACTION_FAILURES=$((ACTION_FAILURES + 1)) ;;
    esac

    printf '%-34s ' "$(basename "$repo")"
    cc_status_word "$status"
    printf ' %s\n' "$detail"
}

repo_action_header() {
    printf '%-34s %-6s %s\n' "Repository" "Result" "Detail"
    printf '%-34s %-6s %s\n' "----------" "------" "------"
}

repo_action_summary() {
    echo
    echo "Action Summary"
    echo "--------------"
    printf '%-14s %s\n' "PASS:" "$ACTION_PASSES"
    printf '%-14s %s\n' "WARN:" "$ACTION_WARNINGS"
    printf '%-14s %s\n' "FAIL:" "$ACTION_FAILURES"
}

repo_origin_branch_ref() {
    local repo="$1" branch
    branch="$(repo_branch "$repo")"
    [ "$branch" != "detached" ] || return 1
    git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch" || return 1
    echo "origin/$branch"
}

PUSH_BRANCH=""
PUSH_REF=""
PUSH_AHEAD=0
PUSH_BEHIND=0
PUSH_READY=0
PUSH_STATUS="PASS"
PUSH_DETAIL=""

repo_analyze_push() {
    local repo="$1" origin counts

    PUSH_BRANCH="$(repo_branch "$repo")"
    PUSH_REF=""
    PUSH_AHEAD=0
    PUSH_BEHIND=0
    PUSH_READY=0
    PUSH_STATUS="PASS"
    PUSH_DETAIL=""

    if [ "$PUSH_BRANCH" = "detached" ]; then
        PUSH_STATUS="WARN"
        PUSH_DETAIL="detached HEAD; skipped"
        return 0
    fi

    origin="$(repo_origin "$repo")"
    if [ "$origin" = "none" ]; then
        PUSH_STATUS="WARN"
        PUSH_DETAIL="no origin remote; skipped"
        return 0
    fi

    PUSH_REF="$(repo_origin_branch_ref "$repo" 2>/dev/null || true)"
    if [ -z "$PUSH_REF" ]; then
        PUSH_STATUS="WARN"
        PUSH_DETAIL="origin/$PUSH_BRANCH not found; skipped"
        return 0
    fi

    counts="$(git -C "$repo" rev-list --left-right --count HEAD..."$PUSH_REF" 2>/dev/null || true)"
    if [ -z "$counts" ]; then
        PUSH_STATUS="FAIL"
        PUSH_DETAIL="could not compare HEAD with $PUSH_REF"
        return 0
    fi

    PUSH_AHEAD="$(echo "$counts" | awk '{print $1}')"
    PUSH_BEHIND="$(echo "$counts" | awk '{print $2}')"

    if [ "$PUSH_BEHIND" -gt 0 ] 2>/dev/null; then
        PUSH_STATUS="WARN"
        PUSH_DETAIL="ahead:$PUSH_AHEAD behind:$PUSH_BEHIND relative to $PUSH_REF; skipped"
        return 0
    fi

    if [ "$PUSH_AHEAD" -gt 0 ] 2>/dev/null; then
        PUSH_READY=1
        PUSH_STATUS="PASS"
        PUSH_DETAIL="ahead:$PUSH_AHEAD behind:$PUSH_BEHIND relative to $PUSH_REF"
    else
        PUSH_STATUS="PASS"
        PUSH_DETAIL="ahead:$PUSH_AHEAD behind:$PUSH_BEHIND relative to $PUSH_REF; skipped"
    fi
}

repo_commit() {
    local repo="$1" state branch

    state="$(repo_state "$repo")"
    if [ "$state" = "clean" ]; then
        repo_action_result "$repo" "PASS" "clean; skipped"
        return 0
    fi

    branch="$(repo_branch "$repo")"
    if [ "$branch" = "detached" ]; then
        repo_action_result "$repo" "WARN" "detached HEAD; skipped"
        return 0
    fi

    if repo_has_unmerged_paths "$repo"; then
        repo_action_result "$repo" "FAIL" "unmerged paths; resolve conflicts before commit"
        return 0
    fi

    if [ "$APPLY" -eq 1 ]; then
        if git -C "$repo" add -A && git -C "$repo" commit -m "$MESSAGE"; then
            repo_action_result "$repo" "PASS" "committed dirty working tree"
        else
            repo_action_result "$repo" "FAIL" "commit failed"
        fi
    else
        repo_action_result "$repo" "PASS" "dry-run: would stage all changes and commit with supplied message"
    fi
}

repo_push() {
    local repo="$1" state

    state="$(repo_state "$repo")"
    if [ "$state" != "clean" ]; then
        repo_action_result "$repo" "WARN" "dirty; skipped; $(repo_ahead_behind "$repo")"
        return 0
    fi

    repo_analyze_push "$repo"
    if [ "$PUSH_READY" -ne 1 ]; then
        repo_action_result "$repo" "$PUSH_STATUS" "$PUSH_DETAIL"
        return 0
    fi

    if [ "$APPLY" -eq 1 ]; then
        if git -C "$repo" push origin "$PUSH_BRANCH"; then
            repo_action_result "$repo" "PASS" "pushed $PUSH_AHEAD commit(s) to origin/$PUSH_BRANCH"
        else
            repo_action_result "$repo" "FAIL" "push to origin/$PUSH_BRANCH failed"
        fi
    else
        repo_action_result "$repo" "PASS" "dry-run: would push $PUSH_AHEAD commit(s) to origin/$PUSH_BRANCH"
    fi
}

repo_publish() {
    local repo="$1" state branch

    state="$(repo_state "$repo")"
    if [ "$state" != "clean" ]; then
        repo_action_result "$repo" "WARN" "dirty; skipped; publish requires a clean working tree"
        return 0
    fi

    branch="$(repo_branch "$repo")"
    if [ "$branch" != "main" ]; then
        repo_action_result "$repo" "WARN" "branch:$branch; skipped; publish requires main"
        return 0
    fi

    if [ "$(repo_origin "$repo")" = "none" ]; then
        repo_action_result "$repo" "WARN" "no origin remote; skipped"
        return 0
    fi

    if [ "$APPLY" -eq 1 ]; then
        if git -C "$repo" push origin main; then
            repo_action_result "$repo" "PASS" "ran git push origin main"
        else
            repo_action_result "$repo" "FAIL" "git push origin main failed"
        fi
        return 0
    fi

    repo_action_result "$repo" "PASS" "dry-run: would run git push origin main"
}

print_header

if [ ! -d "$ROOT" ]; then
    cc_error "Repository root not found: $ROOT"
    exit 1
fi

case "$ACTION" in
    list)
        find_repos
        ;;
    status)
        printf '%-34s %-10s %-10s %-16s %-8s %-22s %s\n' "Repository" "Health" "Type" "Branch" "State" "Sync" "Origin"
        printf '%-34s %-10s %-10s %-16s %-8s %-22s %s\n' "----------" "------" "----" "------" "-----" "----" "------"
        while read -r repo; do
            [ -n "$repo" ] || continue
            printf '%-34s %-10s %-10s %-16s %-8s %-22s %s\n' "$(basename "$repo")" "$(repo_health "$repo")" "$(repo_type "$repo")" "$(repo_branch "$repo")" "$(repo_state "$repo")" "$(repo_ahead_behind "$repo")" "$(repo_origin "$repo")"
        done < <(find_repos)
        summary_footer
        ;;
    health)
        printf '%-34s %-10s %-10s %-16s %-8s %-22s\n' "Repository" "Health" "Type" "Branch" "State" "Sync"
        printf '%-34s %-10s %-10s %-16s %-8s %-22s\n' "----------" "------" "----" "------" "-----" "----"
        while read -r repo; do
            [ -n "$repo" ] || continue
            printf '%-34s %-10s %-10s %-16s %-8s %-22s\n' "$(basename "$repo")" "$(repo_health "$repo")" "$(repo_type "$repo")" "$(repo_branch "$repo")" "$(repo_state "$repo")" "$(repo_ahead_behind "$repo")"
        done < <(find_repos)
        summary_footer
        ;;
    inventory)
        write_inventory
        ;;
    fetch)
        while read -r repo; do
            [ -n "$repo" ] || continue
            echo
            echo "[$(basename "$repo")] $repo"
            repo_fetch "$repo"
        done < <(find_repos)
        ;;
    pull)
        while read -r repo; do
            [ -n "$repo" ] || continue
            echo
            echo "[$(basename "$repo")] $repo"
            repo_pull "$repo"
        done < <(find_repos)
        ;;
    sync)
        while read -r repo; do
            [ -n "$repo" ] || continue
            echo
            echo "[$(basename "$repo")] $repo"
            repo_fetch "$repo"
            repo_pull "$repo"
        done < <(find_repos)
        ;;
    backup)
        printf '%-14s %s\n' "Bundle dir:" "$BUNDLE_DIR"
        while read -r repo; do
            [ -n "$repo" ] || continue
            echo
            echo "[$(basename "$repo")] $repo"
            repo_backup "$repo"
        done < <(find_repos)
        ;;
    commit)
        repo_action_header
        while read -r repo; do
            [ -n "$repo" ] || continue
            repo_commit "$repo"
        done < <(find_repos)
        repo_action_summary
        [ "$ACTION_FAILURES" -eq 0 ]
        ;;
    push)
        repo_action_header
        while read -r repo; do
            [ -n "$repo" ] || continue
            repo_push "$repo"
        done < <(find_repos)
        repo_action_summary
        [ "$ACTION_FAILURES" -eq 0 ]
        ;;
    publish)
        repo_action_header
        while read -r repo; do
            [ -n "$repo" ] || continue
            repo_publish "$repo"
        done < <(find_repos)
        repo_action_summary
        [ "$ACTION_FAILURES" -eq 0 ]
        ;;
    verify|doctor)
        while read -r repo; do
            [ -n "$repo" ] || continue
            [ -f "$repo/tools/cc" ] || continue
            echo
            echo "[$(basename "$repo")] cc $ACTION"
            bash "$repo/tools/cc" "$ACTION" || true
        done < <(find_repos)
        ;;
esac
